fn vue_chat(titre: Text, message: Text, answer: Text) -> Text {
    var _o = ""
    _o += "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#fafaf7\">\n  <title>"
    _o += html_escape(titre)
    _o += "</title>\n  <script>(()=>{try{const t=localStorage.getItem('noliae_theme');const v=t||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');if(v!=='light')document.documentElement.setAttribute('data-theme',v)}catch(_){}})()</script>\n  <link rel=\"stylesheet\" href=\"/static/bulma.min.css\"><link rel=\"stylesheet\" href=\"/static/noliae.css\">\n  <style>\n    :root{--ash:#8A8A85;--paper-2:#fff;--bubble:#F4F4F0;--sidebg:#F4F4F0;--pulse-soft:#FFF4F1;--solid-bg:#111;--solid-fg:#fff;--t:.18s;--ease:cubic-bezier(.6,.05,.25,1);--side-w:262px;color-scheme:light}\n    :root[data-theme=\"dark\"]{--ink:#F2F1EC;--carbon:#E8E6E1;--pulse:#FF6B4A;--plaster:#2A2925;--paper:#17160F;--line:#332F26;--muted:#A9A599;--ash:#7A766B;--paper-2:#221F19;--bubble:#242019;--sidebg:#1C1A14;--pulse-soft:#3A241C;--solid-bg:#3A362C;--solid-fg:#F2F1EC;color-scheme:dark}\n    /* OLED : noir pur (#000) plutôt que le brun-noir du dark classique —\n       vraie économie de courant sur les pixels OLED, chaque pixel \"off\". */\n    :root[data-theme=\"oled\"]{--ink:#F5F5F5;--carbon:#EBEBEB;--pulse:#FF6B4A;--plaster:#141414;--paper:#000;--line:#1C1C1C;--muted:#9C9C9C;--ash:#6E6E6E;--paper-2:#0A0A0A;--bubble:#111;--sidebg:#000;--pulse-soft:#2A140F;--solid-bg:#242424;--solid-fg:#F5F5F5;color-scheme:dark}\n    *,*::before,*::after{box-sizing:border-box}\n    html,body{height:100%;margin:0}\n    body{font-family:var(--sans);background:var(--paper);color:var(--ink);font-size:15px;overflow:hidden}\n    button{background:none;border:0;padding:0;margin:0;cursor:pointer;color:inherit;font:inherit}\n    .app{display:grid;grid-template-columns:var(--side-w) 1fr;height:100vh;transition:grid-template-columns var(--t) var(--ease)}\n    .app.collapsed{grid-template-columns:0 1fr}\n    .side{background:var(--sidebg);border-right:1px solid var(--line);display:flex;flex-direction:column;overflow:hidden;min-width:0}\n    .side .sh{display:flex;align-items:center;justify-content:space-between;padding:14px 14px 10px}\n    .side .brand{display:flex;align-items:center;gap:9px;font-family:var(--mono);font-weight:500;font-size:15px;letter-spacing:-.05em;color:var(--ink);text-decoration:none}\n    .side .brand .wave{gap:2px}\n    .side .brand .wave i{width:3px;background:var(--ink);border-radius:4px}\n    .side .brand .wave i:nth-child(1),.side .brand .wave i:nth-child(7){height:7px}\n    .side .brand .wave i:nth-child(2),.side .brand .wave i:nth-child(6){height:12px}\n    .side .brand .wave i:nth-child(3),.side .brand .wave i:nth-child(5){height:16px}\n    .side .brand .wave i:nth-child(4){height:20px;background:var(--pulse)}\n    .side .slash{font-family:var(--mono);font-size:8px;letter-spacing:.16em;text-transform:uppercase;color:var(--pulse);padding:3px 6px;border:1px solid rgba(255,77,46,.4);border-radius:100px}\n    .newc{display:flex;align-items:center;gap:9px;margin:2px 12px 12px;padding:10px 12px;border:1px solid var(--line);background:var(--paper-2);border-radius:10px;font-size:13.5px;font-weight:500;transition:border-color var(--t),box-shadow var(--t)}\n    .newc:hover{border-color:var(--ash);box-shadow:0 1px 4px rgba(0,0,0,.04)}\n    .newc svg{width:16px;height:16px;display:block}\n    .convs{flex:1;overflow-y:auto;padding:2px 8px 12px}\n    .convs .dh{font-family:var(--mono);font-size:8.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--ash);padding:12px 8px 6px}\n    .conv{display:flex;align-items:center;gap:8px;padding:9px 10px;border-radius:8px;cursor:pointer;color:var(--muted);font-size:13.5px;transition:background var(--t),color var(--t);position:relative}\n    .conv .logo{width:15px;height:15px;flex-shrink:0}\n    .conv:hover{background:rgba(0,0,0,.045);color:var(--ink)}\n    .conv.on{background:var(--paper-2);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.05)}\n    .conv .tt{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .conv .del{opacity:0;width:22px;height:22px;border-radius:6px;display:grid;place-items:center;color:var(--ash);flex-shrink:0;transition:opacity var(--t),background var(--t),color var(--t)}\n    .conv:hover .del{opacity:1}\n    .conv .del:hover{background:#FFE9E2;color:var(--pulse)}\n    .conv .del svg{width:13px;height:13px}\n    .side .sf{padding:12px;border-top:1px solid var(--line);display:flex;align-items:center;gap:10px}\n    .theme-toggle{width:34px;height:34px;margin-left:auto;flex-shrink:0}\n    .theme-toggle:hover{background:var(--bubble);color:var(--muted)}\n    .theme-toggle svg{width:16px;height:16px;grid-area:1/1}\n    .theme-toggle .moon,.theme-toggle .oled{display:none}\n    :root[data-theme=\"dark\"] .theme-toggle .sun{display:none}\n    :root[data-theme=\"dark\"] .theme-toggle .moon{display:block}\n    :root[data-theme=\"oled\"] .theme-toggle .sun{display:none}\n    :root[data-theme=\"oled\"] .theme-toggle .oled{display:block}\n    .side .sf a{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit;flex:1;min-width:0}\n    .side .sf .av{width:28px;height:28px;border-radius:50%;background:var(--solid-bg);color:var(--solid-fg);display:grid;place-items:center;font-family:var(--mono);font-size:11px;font-weight:500;flex-shrink:0}\n    .side .sf .nm{font-size:12.5px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .side .sf .rl{font-size:11px;color:var(--ash);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .main{display:flex;flex-direction:column;min-width:0;overflow:hidden}\n    .top{height:52px;display:flex;align-items:center;gap:12px;padding:0 16px;flex-shrink:0}\n    .iconbtn{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;color:var(--muted);transition:background var(--t)}\n    .iconbtn:hover{background:var(--bubble)}\n    .iconbtn svg{width:18px;height:18px;display:block}\n    .cur-model{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:500;color:var(--muted)}\n    .top{position:relative}\n    .share-btn{margin-left:auto;display:flex;align-items:center;gap:7px;padding:7px 13px;border:1px solid var(--line);border-radius:100px;font-size:12.5px;font-weight:500;color:var(--muted);transition:border-color var(--t),color var(--t),background var(--t)}\n    .share-btn:hover{border-color:var(--ash);color:var(--ink);background:var(--bubble)}\n    .share-btn.on{border-color:var(--pulse);color:var(--pulse);background:var(--pulse-soft)}\n    .share-btn svg{width:14px;height:14px}\n    .share-pop{position:absolute;top:48px;right:16px;z-index:50;width:300px;background:var(--paper-2);border:1px solid var(--line);border-radius:14px;box-shadow:0 12px 30px rgba(0,0,0,.12);padding:14px}\n    .share-pop h4{margin:0 0 4px;font-size:13.5px;font-weight:600}\n    .share-pop p{margin:0 0 10px;font-size:12px;color:var(--ash);line-height:1.5}\n    .share-pop .row{display:flex;gap:6px}\n    .share-pop input{flex:1;height:34px;border:1px solid var(--line);border-radius:8px;padding:0 10px;font-size:11.5px;font-family:var(--mono);background:var(--paper);color:var(--muted)}\n    .share-pop button{height:34px;padding:0 12px;border-radius:8px;background:var(--solid-bg);color:var(--solid-fg);font-size:12px;font-weight:600;flex-shrink:0}\n    .share-pop button:hover{background:var(--pulse)}\n    .share-pop .unshare{margin-top:9px;background:none;color:var(--pulse);font-size:11.5px;font-weight:500;padding:0;height:auto}\n    .cur-model .logo{width:17px;height:17px}\n    .logo{width:19px;height:19px;flex-shrink:0;display:block;border-radius:5px}\n    .composer-toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:8px}\n    .tools-left{display:flex;align-items:center;gap:6px;flex-wrap:wrap;min-width:0}\n    .providers{display:flex;align-items:center;gap:6px;flex-wrap:wrap}\n    .providers .prov{display:flex;align-items:center;gap:4px;height:22px;padding:0 8px;border:1px solid var(--line);border-radius:100px;font-size:10.5px;font-weight:500;background:var(--paper);color:#57534e;transition:border-color var(--t),color var(--t),background var(--t)}\n    .providers .prov:hover{border-color:var(--ash);color:var(--ink)}\n    .providers .prov.on{border-color:var(--pulse);color:var(--ink);background:var(--pulse-soft)}\n    .providers .prov .logo{width:13px;height:13px}\n    .providers .prov .cv{width:11px;height:11px;color:var(--ash)}\n    .ia-modal-veil{position:fixed;inset:0;background:rgba(17,17,17,.4);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;z-index:100;padding:24px}\n    .ia-modal{width:100%;max-width:420px;max-height:80vh;background:var(--paper-2);border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.25);display:flex;flex-direction:column;overflow:hidden}\n    .ia-modal header{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid var(--line);flex-shrink:0}\n    .ia-modal header h2{font-size:15px;font-weight:600;margin:0}\n    .modal-list{overflow-y:auto;padding:8px}\n    .modal-group{padding:10px 10px 4px;font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ash)}\n    .modal-opt{display:flex;align-items:center;gap:11px;padding:10px;border-radius:10px;cursor:pointer;transition:background var(--t)}\n    .modal-opt:hover{background:var(--bubble)}\n    .modal-opt .logo{width:24px;height:24px}\n    .modal-opt .tx{flex:1;min-width:0}\n    .modal-opt .nm{font-size:13.5px;font-weight:500;color:var(--ink)}\n    .modal-opt .ds{font-size:11.5px;color:var(--ash);margin-top:1px}\n    .modal-opt .ck{width:16px;height:16px;color:var(--ink);opacity:0;flex-shrink:0}\n    .modal-opt.on .ck{opacity:1}\n    .scroll{flex:1;overflow-y:auto}\n    .stage{width:100%;max-width:920px;margin:0 auto;padding:0 24px;min-height:100%;display:flex;flex-direction:column}\n    .empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding-bottom:8vh}\n    .empty .mark{filter:drop-shadow(0 4px 10px rgba(0,0,0,.08))}\n    .empty .mark .wave{gap:4px;align-items:center}\n    .empty .mark .wave i{width:8px;background:var(--ink);border-radius:5px;transform-origin:center;animation:eq .9s ease-in-out infinite}\n    .empty .mark .wave i:nth-child(1),.empty .mark .wave i:nth-child(7){height:24px;animation-delay:-.6s}\n    .empty .mark .wave i:nth-child(2),.empty .mark .wave i:nth-child(6){height:40px;animation-delay:-.3s}\n    .empty .mark .wave i:nth-child(3),.empty .mark .wave i:nth-child(5){height:56px;animation-delay:-.75s}\n    .empty .mark .wave i:nth-child(4){height:70px;background:var(--pulse);animation-delay:-.15s}\n    @keyframes eq{0%,100%{transform:scaleY(.45)}50%{transform:scaleY(1)}}\n    @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}\n    .empty .h{font-size:22px;font-weight:500;letter-spacing:-.02em}\n    .empty .sub{font-size:14px;color:var(--ash);margin-top:-8px}\n    .sugg{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;max-width:520px;margin-top:6px}\n    .sugg button{font-size:12.5px;color:var(--muted);padding:8px 13px;border:1px solid var(--line);border-radius:100px;background:var(--paper-2);transition:border-color var(--t),color var(--t),transform var(--t)}\n    .sugg button:hover{border-color:var(--ash);color:var(--ink);transform:translateY(-1px)}\n    .thread{padding:22px 0 20px;display:flex;flex-direction:column;gap:22px}\n    .msg{display:flex;gap:12px}\n    .msg.u{flex-direction:row-reverse;justify-content:flex-start}\n    .msg .ava{width:26px;height:26px;border-radius:7px;flex-shrink:0;display:grid;place-items:center;overflow:hidden}\n    .msg.u .ava{background:var(--solid-bg);color:var(--solid-fg);font-family:var(--mono);font-size:10px;font-weight:500;border-radius:50%}\n    .msg.u .body{flex:0 1 auto;max-width:72%;background:var(--bubble);border-radius:16px 16px 4px 16px;padding:10px 14px;color:var(--ink)}\n    .msg.u .body p{margin:0 0 6px}.msg.u .body p:last-child{margin:0}\n    .msg .ava .logo{width:26px;height:26px;border-radius:7px}\n    .msg .body{padding-top:2px;line-height:1.62;flex:1;min-width:0;color:var(--carbon)}\n    .msg .body,.msg .body *{color:var(--carbon)!important;text-decoration:none!important}\n    .msg .body :not(pre):not(code):not(.dots i):not(.who){background:none!important}\n    .msg .body code{background:var(--bubble)!important}\n    .msg .body .dots i{background:var(--ash)!important}\n    .msg.u .body,.msg.u .body *{color:var(--ink)!important}\n    .msg .body p{margin:0 0 10px}.msg .body p:last-child{margin:0}\n    .msg .body ul,.msg .body ol{margin:0 0 10px;padding-left:20px}\n    .msg .body li{margin:3px 0}\n    .msg .body code{font-family:var(--mono);font-size:.86em;background:var(--bubble);padding:1px 5px;border-radius:4px}\n    .msg .body pre{position:relative;background:#1E1E1C!important;border:1px solid var(--line);border-radius:8px;padding:14px 14px 12px;overflow-x:auto;margin:0 0 10px}\n    .msg .body pre code{background:none!important;padding:0;font-size:12.5px;line-height:1.6;color:#E8E6E1!important}\n    .msg .body .code-lang{position:absolute;top:0;right:0;padding:3px 10px;font:10px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:#9A968D!important;background:rgba(255,255,255,.08)!important;border-radius:0 8px 0 8px}\n    .msg .body .tok-kw{color:#FF8B6B!important;font-weight:500}\n    .msg .body .tok-str{color:#9FD68C!important}\n    .msg .body .tok-cm{color:#8A8680!important;font-style:italic}\n    .msg .body .tok-num{color:#8EC9E8!important}\n    .msg .body strong{font-weight:600}\n    .msg .body .msg-img{max-width:100%;max-height:340px;border-radius:10px;border:1px solid var(--line);display:block;margin:4px 0 10px}\n    .msg .who{font-size:11px;color:var(--ash);font-weight:500;margin-bottom:3px}\n    .dots{display:inline-flex;gap:4px;padding-top:6px}\n    .dots i{width:6px;height:6px;border-radius:50%;background:var(--ash);animation:bl 1.2s infinite}\n    .dots i:nth-child(2){animation-delay:.2s}.dots i:nth-child(3){animation-delay:.4s}\n    @keyframes bl{0%,60%,100%{opacity:.25}30%{opacity:1}}\n    .dock{flex-shrink:0;padding:4px 20px 10px;background:linear-gradient(to top,var(--paper) 66%,transparent)}\n    .composer{width:100%;max-width:920px;margin:0 auto}\n    .composer-card{background:var(--paper-2);border:1px solid var(--line);border-radius:20px;padding:12px 14px 10px;box-shadow:0 1px 3px rgba(0,0,0,.04);transition:border-color var(--t),box-shadow var(--t)}\n    .composer-card:focus-within{border-color:var(--ash);box-shadow:0 6px 20px rgba(0,0,0,.07)}\n    .tools-left .ic{width:22px;height:22px;padding:0;border-radius:50%;display:grid;place-items:center;color:var(--ash);flex-shrink:0;transition:background var(--t),color var(--t)}\n    .tools-left .ic:hover{background:var(--bubble);color:var(--muted)}\n    .tools-left .ic svg{width:13px;height:13px;display:block}\n    textarea{width:100%;display:block;resize:none;border:0;outline:0;background:none;font-size:14px;font-family:var(--sans);line-height:1.25;padding:0 2px;max-height:100px;color:var(--ink);color-scheme:light;-webkit-text-fill-color:var(--ink)}\n    textarea::placeholder{color:var(--ash)}\n    .composer-toolbar .send{width:24px;height:24px;padding:0;border-radius:50%;background:var(--solid-bg);color:var(--solid-fg);display:grid;place-items:center;flex-shrink:0;transition:opacity var(--t),transform var(--t),background var(--t)}\n    .send:not(:disabled):hover{background:var(--pulse)}\n    .send:disabled{background:var(--line);color:var(--ash);cursor:default}\n    .send:not(:disabled):hover{transform:scale(1.05)}\n    .send svg{width:16px;height:16px;display:block}\n    .foot{text-align:center;font-size:10.5px;color:var(--ash);margin-top:6px}\n    .share-cta{display:flex;align-items:center;justify-content:center;gap:14px;padding:12px 18px;border:1px solid var(--line);border-radius:14px;background:var(--paper-2);font-size:12.5px;color:var(--muted)}\n    .share-cta a{color:var(--pulse);font-weight:600;text-decoration:none;white-space:nowrap}\n    .notice{color:var(--pulse)}\n    @media(max-width:760px){.app{grid-template-columns:0 1fr}.side{border-right:0}}\n    @media(max-width:480px){\n      .top{gap:6px;padding:0 10px}\n      .cur-model span{display:none}\n      .share-btn{padding:7px 10px}\n      .share-btn span{display:none}\n      .share-pop{right:8px;left:8px;width:auto}\n      .stage{padding:0 12px}\n      .composer{padding:0 2px}\n      .dock{padding:4px 10px 10px}\n    }\n  </style>\n</head>\n<body>\n<div class=\"app\" id=\"app\">\n  <aside class=\"side\">\n    <div class=\"sh\">\n      <a class=\"brand\" data-app=\"search\" href=\"/\"><span class=\"wave\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span><span data-brand>noliae</span><span class=\"slash\">AI</span></a>\n    </div>\n    <button class=\"newc\" type=\"button\" id=\"newChat\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"><path d=\"M12 5v14M5 12h14\"></path></svg>Nouvelle discussion</button>\n    <div class=\"convs\" id=\"convs\"></div>\n    <div class=\"sf\"><a data-app=\"account\" href=\"/compte\"><span class=\"av\" id=\"side-av\">·</span><div><div class=\"nm\" id=\"side-name\">…</div><div class=\"rl\" id=\"side-email\"></div></div></a></div>\n  </aside>\n\n  <div class=\"main\">\n    <div class=\"top\">\n      <button class=\"iconbtn\" id=\"toggle\" title=\"Masquer l'historique\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"></rect><path d=\"M9 4v16\"></path></svg></button>\n      <div class=\"cur-model\" id=\"curModelBadge\"></div>\n      <button type=\"button\" class=\"share-btn\" id=\"shareBtn\" hidden><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M18 8a3 3 0 1 0-2.83-4H15a3 3 0 0 0 .05 2.9L8.9 10.2a3 3 0 1 0 0 3.6l6.15 3.3A3 3 0 1 0 18 16a2.98 2.98 0 0 0-.24 1.06l-6.2-3.33a3 3 0 0 0 0-1.46l6.2-3.33A3 3 0 0 0 18 8Z\"></path></svg><span>Partager</span></button>\n      <button type=\"button\" class=\"iconbtn theme-toggle\" id=\"themeToggle\" title=\"Changer de thème (clair / sombre / OLED)\"><svg class=\"sun\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg><svg class=\"moon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z\"/></svg><svg class=\"oled\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"currentColor\"/></svg></button>\n      <div class=\"share-pop\" id=\"sharePop\" hidden>\n        <h4>Lien de partage public</h4>\n        <p>Toute personne avec ce lien peut lire cette conversation, sans se connecter.</p>\n        <div class=\"row\"><input type=\"text\" id=\"shareUrl\" readonly><button type=\"button\" id=\"shareCopy\">Copier</button></div>\n        <button type=\"button\" class=\"unshare\" id=\"shareOff\">Arrêter le partage</button>\n      </div>\n    </div>\n\n    <div class=\"scroll\" id=\"scroll\">\n      <div class=\"stage\">\n        <div class=\"empty\" id=\"empty\">\n          <div class=\"mark\"><span class=\"wave\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span></div>\n          <div class=\"h\">Comment puis-je vous aider ?</div>\n          <div class=\"sub\">Choisissez un modèle et posez votre question.</div>\n          <div class=\"sugg\" id=\"sugg\">\n            <button type=\"button\">Rédige un e-mail de relance client</button>\n            <button type=\"button\">Explique le WAF en une phrase</button>\n            <button type=\"button\">Idées de nom pour un SaaS</button>\n            <button type=\"button\">Corrige ce texte en français</button>\n          </div>\n        </div>\n        <div class=\"thread\" id=\"thread\" style=\"display:none\"></div>\n      </div>\n    </div>\n\n    <div class=\"dock\">\n      <div class=\"composer\">\n        <div class=\"composer-card\">\n          <textarea id=\"ta\" rows=\"1\" placeholder=\"Écrivez votre question…\" disabled></textarea>\n          <div class=\"composer-toolbar\">\n            <div class=\"tools-left\">\n              <button class=\"ic\" id=\"attach\" title=\"Joindre un document\" type=\"button\" disabled><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M21 12.5 12.5 21a5 5 0 0 1-7-7l8.5-8.5a3.5 3.5 0 0 1 5 5L10.5 19a2 2 0 0 1-3-3l8-8\"></path></svg></button>\n              <input type=\"file\" id=\"attachInput\" accept=\".txt,.md,.csv,.json,.log,text/plain,image/png,image/jpeg,image/webp,image/gif\" hidden>\n              <div class=\"providers\" id=\"providers\"></div>\n            </div>\n            <button class=\"send\" id=\"send\" disabled type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M12 20V5M6 11l6-6 6 6\"></path></svg></button>\n          </div>\n        </div>\n        <div class=\"foot\" id=\"foot\">Noliae AI peut se tromper · vérifiez les informations importantes.</div>\n      </div>\n    </div>\n  </div>\n</div>\n<div class=\"ia-modal-veil\" id=\"modelModalVeil\" hidden>\n  <div class=\"ia-modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Choisir un modèle\">\n    <header><h2>Choisir un modèle</h2><button type=\"button\" class=\"iconbtn\" id=\"modelModalClose\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M6 6l12 12M18 6 6 18\"/></svg></button></header>\n    <div class=\"modal-list\" id=\"modelModalList\"></div>\n  </div>\n</div>\n<script src=\"/static/links.js\"></script>\n<script>\n(()=>{\nconst p=location.hostname.split('.'),api=p.length<3?location.origin:location.protocol+'//api.'+p.slice(1).join('.'),\nlogin=p.length<3?'/':location.protocol+'//login.'+p.slice(1).join('.'),\ngoLogin=()=>location.replace(login+'/?return_to='+encodeURIComponent(location.href));\n\nconst LOGOS={\n  chatgpt:'<svg class=\"logo\" viewBox=\"0 0 24 24\"><rect width=\"24\" height=\"24\" rx=\"5\" fill=\"var(--paper-2)\" stroke=\"var(--line)\"/><path fill=\"var(--ink)\" d=\"M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.8956zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.4592a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654 2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z\"/></svg>',\n  claude:'<svg class=\"logo\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#D97757\"/><path fill=\"#fff\" d=\"M12.4 26.5 17 14.2c.2-.5.6-.7 1.1-.7s.9.3 1.1.7l4.6 12.3c.2.6-.1 1.1-.6 1.3-.6.2-1.1-.1-1.3-.6l-1-2.8h-5.1l-1 2.8c-.2.5-.7.8-1.3.6-.5-.2-.8-.7-.6-1.3Z\"/></svg>',\n  mistral:'<svg class=\"logo\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#0B0B0B\"/><g transform=\"translate(8 11)\"><rect x=\"0\" y=\"0\" width=\"4.6\" height=\"4.6\" fill=\"#FFD800\"/><rect x=\"19.4\" y=\"0\" width=\"4.6\" height=\"4.6\" fill=\"#FFD800\"/><rect x=\"0\" y=\"4.6\" width=\"4.6\" height=\"4.6\" fill=\"#FFAF00\"/><rect x=\"4.8\" y=\"4.6\" width=\"4.6\" height=\"4.6\" fill=\"#FFAF00\"/><rect x=\"14.6\" y=\"4.6\" width=\"4.6\" height=\"4.6\" fill=\"#FFAF00\"/><rect x=\"19.4\" y=\"4.6\" width=\"4.6\" height=\"4.6\" fill=\"#FFAF00\"/><rect x=\"0\" y=\"9.2\" width=\"24\" height=\"4.6\" fill=\"#FF8205\"/><rect x=\"0\" y=\"13.8\" width=\"4.6\" height=\"4.6\" fill=\"#FA500F\"/><rect x=\"9.7\" y=\"13.8\" width=\"4.6\" height=\"4.6\" fill=\"#FA500F\"/><rect x=\"19.4\" y=\"13.8\" width=\"4.6\" height=\"4.6\" fill=\"#FA500F\"/></g></svg>',\n  gemini:'<svg class=\"logo\" viewBox=\"0 0 40 40\"><defs><linearGradient id=\"gg\" x1=\"0\" y1=\"0\" x2=\"40\" y2=\"40\"><stop offset=\"0\" stop-color=\"#4E8CF5\"/><stop offset=\"1\" stop-color=\"#8E5CF6\"/></linearGradient></defs><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#0B0B0B\"/><path fill=\"url(#gg)\" d=\"M20 8c.3 5.5 4.7 9.9 12 12-7.3 2.1-11.7 6.5-12 12-.3-5.5-4.7-9.9-12-12 7.3-2.1 11.7-6.5 12-12Z\"/></svg>',\n  grok:'<svg class=\"logo\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#000\"/><path fill=\"#fff\" d=\"M11 28 22 12h4L15 28h-4Zm6 0 8-11.5V28h-3V21l-3 4.3z\"/></svg>',\n  deepseek:'<svg class=\"logo\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#4D6BFE\"/><circle cx=\"20\" cy=\"20\" r=\"9\" fill=\"#fff\"/><circle cx=\"23\" cy=\"17\" r=\"2.6\" fill=\"#4D6BFE\"/></svg>'\n};\nconst DEFAULT_LOGO='<svg class=\"logo\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#111\"/><path fill=\"#FF4D2E\" d=\"M12 20c.2-4 3.4-7.2 8-7.4-2.6 1.5-4.2 4.3-4.3 7.4.1 3.1 1.7 5.9 4.3 7.4-4.6-.2-7.8-3.4-8-7.4Z\"/></svg>';\nconst logoFor=provider=>LOGOS[provider]||DEFAULT_LOGO;\n\n// Lien de partage public (/chat/<uuid>?public=1) : lecture seule, AUCUNE\n// authentification requise. Voir tout en bas du script (juste avant le\n// bootstrap authentifié) pour le déclenchement réel : toutes les const/let/\n// function dont il dépend (thread, MODELS, renderMsg...) doivent déjà être\n// initialisées, sinon TDZ -> ReferenceError avalée par le .catch().\n\nlet MODELS=[],curModel=null,PROVIDERS=[];\n// Ordre de préférence par coût (les moins chers en tête) : le premier\n// fournisseur DISPONIBLE de cette liste devient le choix par défaut.\nconst ORDRE_ECONOMIQUE=['mistral','gemini','chatgpt','claude'];\nconst MODEL_KEY='noliae_ai_model_v1';\nfunction setCurModel(m){curModel=m;if(m){try{localStorage.setItem(MODEL_KEY,JSON.stringify({provider:m.provider,model:m.model}))}catch(_){}}}\n\n// L'historique vit en base (table conversations/messages, déjà écrite par\n// /v1/ia à chaque message) : cette liste n'est qu'un cache d'affichage de\n// /v1/conversations, jamais la source de vérité.\nlet chats=[],activeId=null,busy=false;\nconst CONVS_KEY='noliae_ai_convs_v1';\n// Rejoue l'historique en cache instantanément (avant même la requête réseau)\n// pour éviter le clignotement « vide puis repeuplé » au refresh.\ntry{const cached=JSON.parse(localStorage.getItem(CONVS_KEY)||'null');if(Array.isArray(cached)){chats=cached;renderConvs()}}catch(_){}\nasync function loadConvs(){\n  try{\n    const r=await fetch(api+'/v1/conversations',{credentials:'include'});\n    if(r.ok){chats=await r.json();try{localStorage.setItem(CONVS_KEY,JSON.stringify(chats))}catch(_){}}\n  }catch(_){}\n  renderConvs();\n}\n\nconst providersEl=document.getElementById('providers');\n// Une entrée par FOURNISSEUR (pas par modèle : la liste complète peut\n// compter des dizaines de variantes) — le premier modèle de chaque\n// fournisseur est déjà son choix « courant » (voir ia_modele_prioritaire\n// côté serveur), donc directement utilisable ici.\nfunction calculerProviders(){\n  const vus=new Set();\n  PROVIDERS=MODELS.filter(m=>{if(vus.has(m.provider))return false;vus.add(m.provider);return true});\n}\n// Une pastille par fournisseur (façon Mammouth) : clic = bascule directe sur\n// ce fournisseur ; re-cliquer sur celui déjà actif ouvre le choix du modèle\n// précis (variantes) quand il y en a plusieurs.\nfunction renderProviders(){\n  providersEl.innerHTML=PROVIDERS.map(p=>'<button type=\"button\" class=\"prov'+(curModel&&curModel.provider===p.provider?' on':'')+'\" data-provider=\"'+esc(p.provider)+'\">'+logoFor(p.provider)+'<span>'+esc(p.label||p.provider)+'</span></button>').join('');\n  providersEl.querySelectorAll('.prov').forEach(btn=>btn.addEventListener('click',()=>{\n    const p=btn.dataset.provider;\n    if(curModel&&curModel.provider===p){openModelModal(p);return}\n    setCurModel(PROVIDERS.find(m=>m.provider===p)||curModel);\n    renderProviders();\n  }));\n  const badge=document.getElementById('curModelBadge');\n  if(curModel)badge.innerHTML=logoFor(curModel.provider)+'<span>'+esc(curModel.model||curModel.label||curModel.provider)+'</span>';\n}\n\nconst modelVeil=document.getElementById('modelModalVeil'),modelList=document.getElementById('modelModalList');\nfunction openModelModal(focusProvider){\n  // Depuis une pastille précise, on ne montre QUE les modèles de ce\n  // fournisseur (choisir ChatGPT ne doit jamais faire apparaître Mistral) ;\n  // sans fournisseur ciblé, tous les fournisseurs restent groupés.\n  const source=focusProvider?MODELS.filter(m=>m.provider===focusProvider):MODELS;\n  const groupes={};\n  source.forEach(m=>{(groupes[m.provider]=groupes[m.provider]||[]).push(m)});\n  const titre=document.querySelector('.ia-modal header h2');\n  titre.textContent=focusProvider?('Choisir un modèle · '+(groupes[focusProvider]&&(groupes[focusProvider][0].label||focusProvider))):'Choisir un modèle';\n  modelList.innerHTML=Object.keys(groupes).map(p=>(focusProvider?'':'<div class=\"modal-group\">'+esc(groupes[p][0].label||p)+'</div>')+groupes[p].map(m=>'<div class=\"modal-opt '+(m===curModel?'on':'')+'\" data-provider=\"'+esc(m.provider)+'\" data-model=\"'+esc(m.model)+'\">'+logoFor(m.provider)+'<div class=\"tx\"><div class=\"nm\">'+esc(m.model)+'</div></div><svg class=\"ck\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12l5 5 9-9\"/></svg></div>').join('')).join('');\n  modelList.querySelectorAll('.modal-opt').forEach(o=>o.addEventListener('click',()=>{\n    setCurModel(MODELS.find(m=>m.provider===o.dataset.provider&&m.model===o.dataset.model)||curModel);\n    renderProviders();closeModelModal();\n  }));\n  modelVeil.hidden=false;\n}\nfunction closeModelModal(){modelVeil.hidden=true}\ndocument.getElementById('modelModalClose').addEventListener('click',closeModelModal);\nmodelVeil.addEventListener('click',e=>{if(e.target===modelVeil)closeModelModal()});\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape')closeModelModal()});\n\ndocument.getElementById('toggle').addEventListener('click',()=>document.getElementById('app').classList.toggle('collapsed'));\ndocument.getElementById('themeToggle').addEventListener('click',()=>{\n  const cur=document.documentElement.getAttribute('data-theme')||'light';\n  const next={light:'dark',dark:'oled',oled:'light'}[cur];\n  if(next==='light')document.documentElement.removeAttribute('data-theme');\n  else document.documentElement.setAttribute('data-theme',next);\n  try{localStorage.setItem('noliae_theme',next)}catch(_){}\n});\nfunction renderConvs(){\n  const c=document.getElementById('convs');\n  if(!chats.length){c.innerHTML='<div class=\"dh\">Aucune discussion</div>';return}\n  c.innerHTML='<div class=\"dh\">Récent</div>'+chats.map(ch=>'<div class=\"conv '+(String(ch.id)===String(activeId)?'on':'')+'\" data-id=\"'+ch.id+'\">'+(ch.provider?logoFor(ch.provider):'')+'<span class=\"tt\">'+escAttr(ch.title)+'</span><button class=\"del\" data-del=\"'+ch.id+'\" title=\"Supprimer\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"><path d=\"M6 7h12M9 7V5h6v2M8 7l1 13h6l1-13\"/></svg></button></div>').join('');\n  c.querySelectorAll('.conv').forEach(el=>el.addEventListener('click',()=>openChat(el.dataset.id)));\n  c.querySelectorAll('[data-del]').forEach(b=>b.addEventListener('click',e=>{e.stopPropagation();delChat(b.dataset.del)}));\n}\nasync function delChat(id){\n  if(String(activeId)===String(id))newChat();\n  chats=chats.filter(c=>String(c.id)!==String(id));renderConvs();\n  try{await fetch(api+'/v1/conversations/'+encodeURIComponent(id),{method:'DELETE',credentials:'include'})}catch(_){}\n}\n\nconst thread=document.getElementById('thread'),empty=document.getElementById('empty'),scroll=document.getElementById('scroll'),ta=document.getElementById('ta'),send=document.getElementById('send');\n// Chaque conversation vit à sa propre URL (/chat/<uuid>), et « nouvelle\n// discussion » à /chat/new — sans ça, un refresh ou un lien partagé\n// ramène toujours à la racine au lieu de rouvrir la bonne conversation.\nconst shareBtn=document.getElementById('shareBtn'),sharePop=document.getElementById('sharePop'),shareUrl=document.getElementById('shareUrl');\nfunction updateShareBtn(){shareBtn.hidden=!activeId;shareBtn.classList.remove('on');sharePop.hidden=true}\nfunction newChat(push){activeId=null;thread.innerHTML='';thread.style.display='none';empty.style.display='';ta.value='';autosize();send.disabled=true;renderConvs();updateShareBtn();if(push!==false&&location.pathname!=='/chat/new')history.pushState({chat:null},'','/chat/new')}\ndocument.getElementById('newChat').addEventListener('click',()=>newChat());\nasync function openChat(id,push){\n  activeId=id;empty.style.display='none';thread.style.display='';thread.innerHTML='';renderConvs();updateShareBtn();\n  if(push!==false&&location.pathname!=='/chat/'+id)history.pushState({chat:id},'','/chat/'+encodeURIComponent(id));\n  const ch=chats.find(c=>String(c.id)===String(id));\n  if(ch){const m=PROVIDERS.find(p=>p.provider===ch.provider);if(m){curModel=MODELS.find(x=>x.provider===ch.provider&&x.model===ch.model)||m;renderProviders()}}\n  try{\n    const r=await fetch(api+'/v1/conversations/'+encodeURIComponent(id)+'/messages',{credentials:'include'});\n    const msgs=r.ok?await r.json():[];\n    msgs.forEach(m=>renderMsg(m.role,m.role==='user'?esc(m.content).replace(/\\n/g,'<br>'):md(m.content),ch&&ch.provider,ch&&ch.model));\n  }catch(_){}\n  scroll.scrollTop=scroll.scrollHeight;\n}\nshareBtn.addEventListener('click',async()=>{\n  if(!activeId)return;\n  if(!sharePop.hidden){sharePop.hidden=true;return}\n  try{\n    const r=await fetch(api+'/v1/conversations/'+encodeURIComponent(activeId)+'/share',{method:'POST',credentials:'include'});\n    if(!r.ok)return;\n    shareUrl.value=location.origin+'/chat/'+activeId+'?public=1';\n    shareBtn.classList.add('on');sharePop.hidden=false;shareUrl.select()\n  }catch(_){}\n});\ndocument.getElementById('shareCopy').addEventListener('click',()=>{shareUrl.select();try{navigator.clipboard.writeText(shareUrl.value)}catch(_){document.execCommand('copy')}});\ndocument.getElementById('shareOff').addEventListener('click',async()=>{\n  if(!activeId)return;\n  try{await fetch(api+'/v1/conversations/'+encodeURIComponent(activeId)+'/share',{method:'DELETE',credentials:'include'})}catch(_){}\n  shareBtn.classList.remove('on');sharePop.hidden=true;\n});\nwindow.addEventListener('popstate',e=>{\n  const id=e.state&&e.state.chat;\n  if(id)openChat(id,false);else newChat(false);\n});\n\nfunction esc(s){return String(s||'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}\nfunction escAttr(s){return esc(s).replace(/\"/g,'&quot;')}\n// Pas de vrai streaming (le client HTTP ne lit pas les réponses en flux) :\n// on simule la frappe en révélant le texte final progressivement, avec un\n// pas adapté à la longueur pour que ça reste rapide sur une longue réponse.\nfunction machineAEcrire(el,who,fullText){\n  const pas=Math.max(1,Math.ceil(fullText.length/120));\n  let i=0;\n  const tick=()=>{\n    i=Math.min(fullText.length,i+pas);\n    el.innerHTML='<div class=\"who\">'+esc(who)+'</div>'+md(fullText.slice(0,i));\n    scroll.scrollTop=scroll.scrollHeight;\n    if(i<fullText.length)requestAnimationFrame(tick)\n  };\n  requestAnimationFrame(tick);\n}\n// Coloration syntaxique légère, générique (pas de vrai lexer par langage) :\n// commentaires/chaînes d'abord (pour ne jamais re-matcher leur contenu),\n// puis nombres et mots-clés usuels toutes langues confondues.\nfunction hl(code){\n  const KW=/\\b(function|const|let|var|return|if|else|for|while|do|switch|case|break|continue|class|extends|new|async|await|try|catch|finally|throw|import|export|from|as|default|def|elif|lambda|None|True|False|echo|public|private|protected|static|void|int|float|bool|string|fn|struct|impl|use|match|pub|mod|self|Self|SELECT|FROM|WHERE|INSERT|INTO|VALUES|UPDATE|SET|DELETE|CREATE|TABLE|JOIN|ON|AND|OR|NOT|NULL|ORDER|BY|GROUP|LIMIT)\\b/g;\n  const NUM=/\\b\\d+(\\.\\d+)?\\b/g;\n  const seg=(t)=>t.replace(KW,x=>'<span class=\"tok-kw\">'+x+'</span>').replace(NUM,x=>'<span class=\"tok-num\">'+x+'</span>');\n  const re=/(\\/\\/[^\\n]*|\\/\\*[\\s\\S]*?\\*\\/|\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*')/g;\n  let out='',last=0,m;\n  while((m=re.exec(code))){\n    out+=seg(code.slice(last,m.index));\n    const tok=m[0];\n    out+='<span class=\"tok-'+((tok[0]==='/')?'cm':'str')+'\">'+tok+'</span>';\n    last=re.lastIndex;\n  }\n  out+=seg(code.slice(last));\n  return out;\n}\nfunction md(s){\n  s=esc(s);\n  // Les blocs code sont extraits AVANT le découpage en lignes ci-dessous :\n  // sinon chaque ligne interne d'un bloc ```...``` se retrouve traitée comme\n  // un paragraphe séparé (d'où le rendu « une ligne par <p>, tout collé »).\n  const blocks=[];\n  s=s.replace(/```(\\w*)\\n?([\\s\\S]*?)```/g,(m,lang,c)=>{\n    c=c.replace(/\\n$/,'');\n    const chip=lang?'<div class=\"code-lang\">'+esc(lang)+'</div>':'';\n    blocks.push('<pre>'+chip+'<code>'+hl(c)+'</code></pre>');\n    return ' B'+(blocks.length-1)+' ';\n  });\n  s=s.replace(/`([^`]+)`/g,'<code>$1</code>');\n  s=s.replace(/!\\[([^\\]]*)\\]\\((https:\\/\\/[^)\\s]+)\\)/g,'<img class=\"msg-img\" src=\"$2\" alt=\"$1\" loading=\"lazy\" referrerpolicy=\"no-referrer\">');\n  s=s.replace(/\\*\\*([^*]+)\\*\\*/g,'<strong>$1</strong>');\n  const lines=s.split('\\n');let out='',list=null;\n  for(let ln of lines){\n    const bm=/^B(\\d+)$/.exec(ln.trim());\n    if(bm){if(list){out+=list==='ul'?'</ul>':'</ol>';list=null}out+=blocks[+bm[1]];continue}\n    if(/^\\s*[-*]\\s+/.test(ln)){if(list!=='ul'){out+='<ul>';list='ul'}out+='<li>'+ln.replace(/^\\s*[-*]\\s+/,'')+'</li>'}else if(/^\\s*\\d+\\.\\s+/.test(ln)){if(list!=='ol'){out+='<ol>';list='ol'}out+='<li>'+ln.replace(/^\\s*\\d+\\.\\s+/,'')+'</li>'}else{if(list){out+=list==='ul'?'</ul>':'</ol>';list=null}if(ln.trim())out+='<p>'+ln+'</p>'}\n  }\n  if(list)out+=list==='ul'?'</ul>':'</ol>';\n  return out;\n}\nfunction renderMsg(role,html,provider,model){\n  const d=document.createElement('div');d.className='msg '+(role==='user'?'u':'a');\n  const ava=role==='user'?(document.getElementById('side-av').textContent):logoFor(provider);\n  const label=MODELS.find(m=>m.provider===provider);\n  const who=model||(label?label.model:'')||(label?label.label:'')||provider||'Noliae AI';\n  d.innerHTML='<div class=\"ava\">'+ava+'</div><div class=\"body\">'+(role==='assistant'?'<div class=\"who\">'+esc(who)+'</div>':'')+html+'</div>';\n  thread.appendChild(d);scroll.scrollTop=scroll.scrollHeight;return d.querySelector('.body')\n}\n\nconst attachBtn=document.getElementById('attach'),attachInput=document.getElementById('attachInput');\nattachBtn.addEventListener('click',()=>attachInput.click());\n// Upload d'image : URL présignée S3 (le navigateur PUT directement sur S3,\n// nos octets ne transitent jamais par notre propre serveur — voir s3.nol\n// côté NolCore pour le pourquoi). Le lien public est ensuite inséré en\n// markdown dans le message ; les modèles configurés ici sont des chat\n// completions texte, donc SANS vision ils ne \"voient\" pas l'image, seulement\n// son URL — c'est un stockage/partage d'image, pas encore une entrée vision.\nasync function uploadImage(file,foot){\n  foot.textContent='Envoi de « '+file.name+' »…';\n  const r=await fetch(api+'/v1/uploads/presign',{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify({content_type:file.type})});\n  const data=await r.json().catch(()=>({}));\n  if(!r.ok)throw new Error(data.detail||'Import d\\'image impossible.');\n  const put=await fetch(data.upload_url,{method:'PUT',headers:{'Content-Type':file.type,'x-amz-acl':'public-read'},body:file});\n  if(!put.ok)throw new Error('Dépôt sur le stockage impossible.');\n  const insert='![image]('+data.public_url+')\\n';\n  ta.value=insert+ta.value;autosize();send.disabled=!ta.value.trim();\n  foot.textContent='Image ajoutée — un lien a été inséré dans votre message.';\n}\nattachInput.addEventListener('change',async()=>{\n  const file=attachInput.files[0];attachInput.value='';\n  if(!file)return;\n  const foot=document.getElementById('foot');\n  const avant=foot.textContent;\n  try{\n    if(file.type&&file.type.startsWith('image/')){\n      await uploadImage(file,foot);\n    }else{\n      foot.textContent='Envoi de « '+file.name+' »…';\n      const content=await file.text();\n      if(!content.trim())throw new Error('Fichier vide.');\n      const r=await fetch(api+'/api/documents',{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify({title:file.name,content})});\n      const data=await r.json().catch(()=>({}));\n      if(!r.ok)throw new Error(data.detail||'Envoi impossible.');\n      foot.textContent='« '+file.name+' » ajouté — le contexte sera utilisé dans vos prochains messages.';\n    }\n  }catch(e){foot.textContent=(e instanceof TypeError)?'La connexion à nos serveurs semble bloquée par une extension (bloqueur de publicités/traceurs).':(e.message||'Envoi impossible.')}\n  setTimeout(()=>{foot.textContent=avant},4000);\n});\nfunction autosize(){ta.style.height='auto';ta.style.height=Math.min(ta.scrollHeight,180)+'px'}\nta.addEventListener('input',()=>{autosize();send.disabled=!ta.value.trim()||busy});\nta.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();submit()}});\nsend.addEventListener('click',submit);\ndocument.querySelectorAll('#sugg button').forEach(b=>b.addEventListener('click',()=>{ta.value=b.textContent;autosize();send.disabled=false;submit()}));\n\nasync function submit(){\n  const q=ta.value.trim();if(!q||busy||!curModel)return;\n  busy=true;send.disabled=true;\n  const isNew=!activeId;\n  if(isNew){empty.style.display='none';thread.style.display=''}\n  renderMsg('user',esc(q).replace(/\\n/g,'<br>'));\n  ta.value='';autosize();\n  const provider=curModel.provider;\n  const body=renderMsg('assistant','<div class=\"dots\"><i></i><i></i><i></i></div>',provider,curModel.model);\n  try{\n    const r=await fetch(api+'/v1/ia',{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify({message:q,provider:curModel.provider,model:curModel.model,conversation_id:activeId||undefined})});\n    const data=await r.json().catch(()=>({}));\n    if(!r.ok)throw data;\n    activeId=data.conversation_id||activeId;\n    if(isNew&&activeId)history.replaceState({chat:activeId},'','/chat/'+encodeURIComponent(activeId));\n    machineAEcrire(body,curModel.model||curModel.label||curModel.provider,data.answer||'Aucune réponse reçue.');\n    // Nouvelle conversation ou historique désynchronisé : on relit la liste\n    // côté serveur plutôt que de deviner le titre/tri localement.\n    await loadConvs();\n  }catch(e){body.innerHTML='<p style=\"color:var(--pulse)\">'+esc((e instanceof TypeError)?'La connexion à nos serveurs semble bloquée par une extension (bloqueur de publicités/traceurs). Désactive-la pour ce site, ou essaie en navigation privée, puis réessaie.':((e&&e.detail)||'Une erreur est survenue. Réessayez dans un instant.'))+'</p>'}\n  scroll.scrollTop=scroll.scrollHeight;\n  busy=false;send.disabled=!ta.value.trim();ta.focus()\n}\n\nconst MODELS_KEY='noliae_ai_models_v1';\n// Idem pour les modèles : on affiche tout de suite les pastilles connues\n// (dernier catalogue vu) pendant que /v1/ia/models revalide en tâche de fond.\ntry{\n  const cachedModels=JSON.parse(localStorage.getItem(MODELS_KEY)||'null');\n  if(Array.isArray(cachedModels)&&cachedModels.length){\n    MODELS=cachedModels;calculerProviders();\n    let restaure0=null;\n    try{const saved0=JSON.parse(localStorage.getItem(MODEL_KEY)||'null');if(saved0)restaure0=MODELS.find(m=>m.provider===saved0.provider&&m.model===saved0.model)}catch(_){}\n    const parEconomie0=ORDRE_ECONOMIQUE.map(p=>PROVIDERS.find(m=>m.provider===p)).find(Boolean);\n    setCurModel(restaure0||parEconomie0||PROVIDERS[0]);\n    renderProviders();\n    ta.disabled=false;document.getElementById('attach').disabled=false;\n  }\n}catch(_){}\n\n// Lien de partage public (/chat/<uuid>?public=1) : lecture seule, AUCUNE\n// authentification requise. Placé ICI (tout en bas, juste avant le\n// bootstrap authentifié) : renderMsg/md/esc/logoFor sont des fonctions\n// hoistées (ok dès le début du script), mais MODELS/thread/etc. sont des\n// let/const dont l'INITIALISATION doit déjà avoir eu lieu, sinon TDZ ->\n// ReferenceError silencieusement avalée par le .catch() du fetch (bug\n// vécu : le lien semblait \"ne plus exister\" alors que l'API répondait 200).\nif(new URLSearchParams(location.search).get('public')==='1'){\n  const m=/^\\/chat\\/([^/]+)$/.exec(location.pathname);\n  document.getElementById('app').classList.add('collapsed');\n  empty.style.display='none';\n  thread.style.display='';\n  document.querySelector('.dock').innerHTML='<div class=\"composer\"><div class=\"share-cta\"><span>Vous consultez une conversation partagée en lecture seule.</span><a href=\"'+login+'/?return_to='+encodeURIComponent(location.origin)+'\">Essayer Noliae IA →</a></div></div>';\n  if(m){\n    fetch(api+'/v1/conversations/'+encodeURIComponent(m[1])+'/public').then(async r=>{\n      if(!r.ok)throw 0; return r.json();\n    }).then(data=>{\n      document.getElementById('curModelBadge').innerHTML=logoFor(data.provider)+'<span>'+esc(data.model||data.provider)+'</span>';\n      (data.messages||[]).forEach(msg=>renderMsg(msg.role,msg.role==='user'?esc(msg.content).replace(/\\n/g,'<br>'):md(msg.content),data.provider,data.model));\n      scroll.scrollTop=0;\n    }).catch(e=>{console.error('partage public:',e);thread.innerHTML='<p style=\"padding:24px;color:var(--ash)\">Cette conversation n\\'est plus partagée, ou n\\'existe pas.</p>'});\n  }\n  return;\n}\n\nfetch(api+'/v1/user/me',{credentials:'include'}).then(async r=>{if(!r.ok)throw 0;return r.json()}).then(user=>{\n  document.getElementById('side-av').textContent=(user.name||user.email||'?').slice(0,2).toUpperCase();\n  document.getElementById('side-name').textContent=user.name||user.email;\n  document.getElementById('side-email').textContent=user.email;\n  return fetch(api+'/v1/ia/models',{credentials:'include'});\n}).then(async r=>{\n  const data=await r.json().catch(()=>[]);\n  MODELS=Array.isArray(data)?data:(Array.isArray(data.models)?data.models:[]);\n  if(!MODELS.length)throw 0;\n  try{localStorage.setItem(MODELS_KEY,JSON.stringify(MODELS))}catch(_){}\n  calculerProviders();\n  let restaure=null;\n  try{const saved=JSON.parse(localStorage.getItem(MODEL_KEY)||'null');if(saved)restaure=MODELS.find(m=>m.provider===saved.provider&&m.model===saved.model)}catch(_){}\n  const parEconomie=ORDRE_ECONOMIQUE.map(p=>PROVIDERS.find(m=>m.provider===p)).find(Boolean);\n  setCurModel(restaure||parEconomie||PROVIDERS[0]);\n  renderProviders();\n  ta.disabled=false;document.getElementById('attach').disabled=false;\n  loadConvs().then(()=>{\n    // Ouvre directement la conversation de l'URL (/chat/<uuid>) au chargement —\n    // sinon un refresh ou un lien partagé retombe toujours sur l'accueil.\n    const m=/^\\/chat\\/([^/]+)$/.exec(location.pathname);\n    if(m&&m[1]!=='new')openChat(m[1],false);\n    history.replaceState({chat:(m&&m[1]!=='new')?m[1]:null},'',location.pathname);\n  });\n}).catch(()=>{ if(!MODELS.length){ goLogin(); } });\n})();\n</script>\n</body></html>\n"
    return _o
}
