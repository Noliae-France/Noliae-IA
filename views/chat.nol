fn vue_chat(titre: Text, message: Text, answer: Text) -> Text {
    var _o = ""
    _o += "<!doctype html><html lang=\"fr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>"
    _o += html_escape(titre)
    _o += "</title><link rel=\"stylesheet\" href=\"/static/noliae.css\"><style>.appbar,.legal{display:none}body{display:block;height:100vh;overflow:hidden}.app{display:grid;grid-template-columns:262px 1fr;height:100vh}.side{background:#F4F4F0;border-right:1px solid #E8E8E3;padding:14px 12px;display:flex;flex-direction:column}.brand{color:#111!important}.new{margin:18px 0 12px;padding:10px 12px;background:#fff;border:1px solid #E4E4DF;border-radius:10px}.side a{display:block;padding:9px 10px;color:#4A4A4A;text-decoration:none;border-radius:8px;font-size:13px}.side a.active{background:#fff;color:#111}.cap{font-size:9px!important;color:#8A8A85!important}.main{display:flex;flex-direction:column;min-width:0}.top{height:52px;padding:10px 16px}.picker{padding:7px 12px;border:1px solid #E4E4DF;border-radius:99px;background:#fff;font-size:13px}.stage{flex:1;overflow:auto;display:flex;align-items:center;justify-content:center}.empty{text-align:center}.empty h1{font-size:23px;font-weight:500}.empty p{color:#8A8A85}.suggestions button{padding:8px 13px;margin:4px;border:1px solid #E4E4DF;border-radius:99px;background:#fff}.dock{padding:10px 24px 20px}.composer{max-width:720px;margin:auto;border:1px solid #E4E4DF!important;border-radius:16px!important;box-shadow:0 2px 8px #0001!important}.composer textarea{min-height:55px}.conversation{max-width:720px;width:100%;margin:auto}.mark{font-size:36px;color:#FF4D2E}.models{margin:8px 0;font-size:12px}.models select{border:1px solid #E4E4DF;border-radius:99px;padding:6px 10px;background:white}.cols{display:flex;gap:12px;width:100%}.col{flex:1;min-width:0;border:1px solid #E4E4DF;border-radius:10px;padding:8px 10px;background:#fff}.col small{color:#8A8A85;font-size:11px;display:block;margin-bottom:4px}.col p{white-space:pre-wrap}#model{min-width:200px;max-height:96px}</style></head><body><div class=\"app\"><aside class=\"side\"><a class=\"brand\" href=\"/\">NolCore <b>IA</b></a><button class=\"new\">＋ Nouvelle discussion</button><p class=\"cap\">Récent</p><a class=\"active\" href=\"/\">Nouvelle discussion</a><a href=\"#\">Mes conversations</a><p class=\"cap\">Outils</p><a href=\"#\">Préférences</a></aside><section class=\"main\"><header class=\"top\"><span class=\"picker\">● <select id=\"model\" multiple size=\"1\" title=\"Ctrl/Cmd-clic pour comparer plusieurs modèles\"><option>Chargement…</option></select></span></header><div class=\"stage\"><div class=\"empty\"><div class=\"mark\">▂█▂</div><h1>Comment puis-je vous aider ?</h1><p>Choisissez un modèle et posez votre question.</p><div class=\"suggestions\"><button>Rédige un e-mail de relance</button><button>Explique le WAF simplement</button><button>Corrige ce texte en français</button></div><div class=\"conversation\">"
    if message != "" {
    _o += "<article class=\"user\"><p>"
    _o += html_escape(message)
    _o += "</p></article><article><p>"
    _o += html_escape(answer)
    _o += "</p></article>"
    }
    _o += "</div></div></div><div class=\"dock\"><form class=\"composer\" id=\"form\"><textarea id=\"message\" placeholder=\"Écrivez votre question…\" required></textarea><div class=\"models\">Modèle disponible via NolCore</div><footer><span>Les réponses peuvent contenir des erreurs.</span><button>↑</button></footer></form></div></section></div><script>(async()=>{const h=location.hostname,a=h.startsWith(\"ia.\")?location.protocol+\"//api.\"+h.slice(3):location.origin,s=document.getElementById(\"model\"),f=document.getElementById(\"form\"),m=document.getElementById(\"message\");try{let r=await fetch(a+\"/v1/ia/models\",{credentials:\"include\"}),v=await r.json();s.innerHTML=v.map(x=>\"<option value='\"+x.provider+\"|\"+x.model+\"'>\"+(x.label||x.provider)+\" · \"+x.model+\"</option>\").join(\"\");if(s.options.length)s.options[0].selected=true}catch(_){s.innerHTML=\"<option>Connexion requise</option>\"}document.querySelectorAll(\".suggestions button\").forEach(b=>b.onclick=()=>{m.value=b.textContent;m.focus()});const stream=async(prov,model,out,q)=>{let rep;try{rep=await fetch(a+\"/v1/ia/stream\",{method:\"POST\",credentials:\"include\",headers:{\"content-type\":\"application/json\"},body:JSON.stringify({provider:prov,model:model,text:q})})}catch(_){out.textContent=\"Connexion impossible.\";return}if(!rep.ok){let o={};try{o=await rep.json()}catch(_){}out.textContent=o.error||o.detail||\"Erreur.\";return}const rd=rep.body.getReader(),dec=new TextDecoder();let buf=\"\",acc=\"\",stop=false;while(!stop){const r2=await rd.read();if(r2.done)break;buf+=dec.decode(r2.value,{stream:true});let nl;while((nl=buf.indexOf(\"\\n\"))>=0){const line=buf.slice(0,nl).trim();buf=buf.slice(nl+1);if(line.startsWith(\"data:\")){const p=line.slice(5).trim();if(p===\"[DONE]\"){stop=true;break}try{const j=JSON.parse(p);if(j.delta){acc+=j.delta;out.textContent=acc}else if(j.error){out.textContent=\"Erreur : \"+j.error}}catch(_){}}}}};f.onsubmit=async e=>{e.preventDefault();const sels=[...s.selectedOptions].map(o=>o.value.split(\"|\")).filter(x=>x.length===2);if(!sels.length)return;const q=m.value;if(!q)return;const conv=document.querySelector(\".conversation\");conv.insertAdjacentHTML(\"beforeend\",\"<article class='user'><p></p></article>\");conv.querySelector(\"article:last-child p\").textContent=q;const base=\"o\"+Date.now()+\"_\";let cols=\"<div class='cols'>\";sels.forEach((x,i)=>{cols+=\"<div class='col'><small>\"+x[0]+\" · \"+x[1]+\"</small><p id='\"+base+i+\"'></p></div>\"});cols+=\"</div>\";conv.insertAdjacentHTML(\"beforeend\",\"<article>\"+cols+\"</article>\");m.value=\"\";await Promise.all(sels.map((x,i)=>stream(x[0],x[1],document.getElementById(base+i),q)))}})();</script></body></html>\n"
    return _o
}
