fn vue_chat(titre: Text, message: Text, answer: Text) -> Text {
    var _o = ""
    _o += "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#fafaf7\">\n  <meta name=\"color-scheme\" content=\"light\">\n  <title>"
    _o += html_escape(titre)
    _o += "</title>\n  <link rel=\"stylesheet\" href=\"/static/noliae.css\">\n  <style>\n    :root{--ash:#8A8A85;--paper-2:#fff;--bubble:#F4F4F0;--sidebg:#F4F4F0;--t:.18s;--ease:cubic-bezier(.6,.05,.25,1);--side-w:262px}\n    *,*::before,*::after{box-sizing:border-box}\n    html,body,input,textarea,select,button{color-scheme:light}\n    html,body{height:100%;margin:0}\n    body{font-family:var(--sans);background:var(--paper);color:var(--ink);font-size:15px;overflow:hidden}\n    button{background:none;border:0;padding:0;margin:0;cursor:pointer;color:inherit;font:inherit}\n    .app{display:grid;grid-template-columns:var(--side-w) 1fr;height:100vh;transition:grid-template-columns var(--t) var(--ease)}\n    .app.collapsed{grid-template-columns:0 1fr}\n    .side{background:var(--sidebg);border-right:1px solid var(--line);display:flex;flex-direction:column;overflow:hidden;min-width:0}\n    .side .sh{display:flex;align-items:center;justify-content:space-between;padding:14px 14px 10px}\n    .side .brand{display:flex;align-items:center;gap:9px;font-family:var(--mono);font-weight:500;font-size:15px;letter-spacing:-.05em;color:var(--ink);text-decoration:none}\n    .side .brand .wave{gap:2px}\n    .side .brand .wave i{width:3px;background:var(--ink);border-radius:4px}\n    .side .brand .wave i:nth-child(1),.side .brand .wave i:nth-child(7){height:7px}\n    .side .brand .wave i:nth-child(2),.side .brand .wave i:nth-child(6){height:12px}\n    .side .brand .wave i:nth-child(3),.side .brand .wave i:nth-child(5){height:16px}\n    .side .brand .wave i:nth-child(4){height:20px;background:var(--pulse)}\n    .side .slash{font-family:var(--mono);font-size:8px;letter-spacing:.16em;text-transform:uppercase;color:var(--pulse);padding:3px 6px;border:1px solid rgba(255,77,46,.4);border-radius:100px}\n    .newc{display:flex;align-items:center;gap:9px;margin:2px 12px 12px;padding:10px 12px;border:1px solid var(--line);background:var(--paper-2);border-radius:10px;font-size:13.5px;font-weight:500;transition:border-color var(--t),box-shadow var(--t)}\n    .newc:hover{border-color:var(--ash);box-shadow:0 1px 4px rgba(0,0,0,.04)}\n    .newc svg{width:16px;height:16px}\n    .convs{flex:1;overflow-y:auto;padding:2px 8px 12px}\n    .convs .dh{font-family:var(--mono);font-size:8.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--ash);padding:12px 8px 6px}\n    .conv{display:flex;align-items:center;gap:8px;padding:9px 10px;border-radius:8px;cursor:pointer;color:var(--muted);font-size:13.5px;transition:background var(--t),color var(--t);position:relative}\n    .conv:hover{background:rgba(0,0,0,.045);color:var(--ink)}\n    .conv.on{background:var(--paper-2);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.05)}\n    .conv .tt{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .conv .del{opacity:0;width:22px;height:22px;border-radius:6px;display:grid;place-items:center;color:var(--ash);flex-shrink:0;transition:opacity var(--t),background var(--t),color var(--t)}\n    .conv:hover .del{opacity:1}\n    .conv .del:hover{background:#FFE9E2;color:var(--pulse)}\n    .conv .del svg{width:13px;height:13px}\n    .side .sf{padding:12px;border-top:1px solid var(--line);display:flex;align-items:center;gap:10px}\n    .side .sf a{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit;flex:1;min-width:0}\n    .side .sf .av{width:28px;height:28px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-family:var(--mono);font-size:11px;font-weight:500;flex-shrink:0}\n    .side .sf .nm{font-size:12.5px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .side .sf .rl{font-size:11px;color:var(--ash);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .main{display:flex;flex-direction:column;min-width:0;overflow:hidden}\n    .top{height:52px;display:flex;align-items:center;gap:12px;padding:0 16px;flex-shrink:0}\n    .iconbtn{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;color:var(--muted);transition:background var(--t)}\n    .iconbtn:hover{background:var(--bubble)}\n    .iconbtn svg{width:18px;height:18px}\n    .cur-model{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:500;color:var(--muted)}\n    .cur-model .logo{width:17px;height:17px}\n    .logo{width:19px;height:19px;flex-shrink:0;display:block;border-radius:5px}\n    .providers{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:6px;margin-top:9px}\n    .provider{display:flex;align-items:center;gap:6px;padding:6px 8px 6px 10px;border:1px solid var(--line);border-radius:100px;font-size:12px;font-weight:500;background:#fff;color:#57534e;opacity:.75;transition:border-color var(--t),color var(--t),background var(--t),opacity var(--t)}\n    .provider span{color:inherit}\n    .provider:hover{border-color:var(--ash);color:var(--ink);opacity:1}\n    .provider.on{border-color:var(--ink);background:#111;color:#fff;opacity:1;font-weight:600}\n    .provider.on .cv{color:#fff}\n    .provider .logo{width:15px;height:15px}\n    .provider .cv{width:12px;height:12px;color:var(--ash)}\n    .modal-veil{position:fixed;inset:0;background:rgba(17,17,17,.4);display:flex;align-items:center;justify-content:center;z-index:100;padding:24px}\n    .modal{width:100%;max-width:420px;max-height:80vh;background:var(--paper-2);border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.25);display:flex;flex-direction:column;overflow:hidden}\n    .modal header{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid var(--line);flex-shrink:0}\n    .modal header h2{font-size:15px;font-weight:600;margin:0}\n    .modal-list{overflow-y:auto;padding:8px}\n    .modal-group{padding:10px 10px 4px;font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ash)}\n    .modal-opt{display:flex;align-items:center;gap:11px;padding:10px;border-radius:10px;cursor:pointer;transition:background var(--t)}\n    .modal-opt:hover{background:var(--bubble)}\n    .modal-opt .logo{width:24px;height:24px}\n    .modal-opt .tx{flex:1;min-width:0}\n    .modal-opt .nm{font-size:13.5px;font-weight:500;color:var(--ink)}\n    .modal-opt .ds{font-size:11.5px;color:var(--ash);margin-top:1px}\n    .modal-opt .ck{width:16px;height:16px;color:var(--ink);opacity:0;flex-shrink:0}\n    .modal-opt.on .ck{opacity:1}\n    .scroll{flex:1;overflow-y:auto}\n    .stage{width:100%;max-width:720px;margin:0 auto;padding:0 24px;min-height:100%;display:flex;flex-direction:column}\n    .empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding-bottom:8vh}\n    .empty .mark{filter:drop-shadow(0 4px 10px rgba(0,0,0,.08));animation:float 4.5s var(--ease) infinite}\n    .empty .mark .wave{gap:4px}\n    .empty .mark .wave i{width:8px;background:var(--ink);border-radius:5px}\n    .empty .mark .wave i:nth-child(1),.empty .mark .wave i:nth-child(7){height:24px}\n    .empty .mark .wave i:nth-child(2),.empty .mark .wave i:nth-child(6){height:40px}\n    .empty .mark .wave i:nth-child(3),.empty .mark .wave i:nth-child(5){height:56px}\n    .empty .mark .wave i:nth-child(4){height:70px;background:var(--pulse)}\n    @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}\n    .empty .h{font-size:22px;font-weight:500;letter-spacing:-.02em}\n    .empty .sub{font-size:14px;color:var(--ash);margin-top:-8px}\n    .sugg{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;max-width:520px;margin-top:6px}\n    .sugg button{font-size:12.5px;color:var(--muted);padding:8px 13px;border:1px solid var(--line);border-radius:100px;background:var(--paper-2);transition:border-color var(--t),color var(--t),transform var(--t)}\n    .sugg button:hover{border-color:var(--ash);color:var(--ink);transform:translateY(-1px)}\n    .thread{padding:22px 0 20px;display:flex;flex-direction:column;gap:22px}\n    .msg{display:flex;gap:12px}\n    .msg .ava{width:26px;height:26px;border-radius:7px;flex-shrink:0;display:grid;place-items:center;overflow:hidden}\n    .msg.u .ava{background:var(--ink);color:#fff;font-family:var(--mono);font-size:10px;font-weight:500;border-radius:50%}\n    .msg .ava .logo{width:26px;height:26px;border-radius:7px}\n    .msg .body{padding-top:2px;line-height:1.62;flex:1;min-width:0;color:var(--carbon)}\n    .msg .body p{margin:0 0 10px}.msg .body p:last-child{margin:0}\n    .msg .body ul,.msg .body ol{margin:0 0 10px;padding-left:20px}\n    .msg .body li{margin:3px 0}\n    .msg .body code{font-family:var(--mono);font-size:.86em;background:var(--bubble);padding:1px 5px;border-radius:4px}\n    .msg .body pre{background:var(--bubble);border:1px solid var(--line);border-radius:8px;padding:12px 14px;overflow-x:auto;margin:0 0 10px}\n    .msg .body pre code{background:none;padding:0;font-size:12.5px;line-height:1.55}\n    .msg .body strong{font-weight:600}\n    .msg .who{font-size:11px;color:var(--ash);font-weight:500;margin-bottom:3px}\n    .dots{display:inline-flex;gap:4px;padding-top:6px}\n    .dots i{width:6px;height:6px;border-radius:50%;background:var(--ash);animation:bl 1.2s infinite}\n    .dots i:nth-child(2){animation-delay:.2s}.dots i:nth-child(3){animation-delay:.4s}\n    @keyframes bl{0%,60%,100%{opacity:.25}30%{opacity:1}}\n    .dock{flex-shrink:0;padding:10px 24px 20px;background:linear-gradient(to top,var(--paper) 66%,transparent)}\n    .composer{width:100%;max-width:720px;margin:0 auto}\n    .box{display:flex;align-items:flex-end;gap:8px;background:var(--paper-2);border:1px solid var(--line);border-radius:16px;padding:8px 8px 8px 14px;box-shadow:0 1px 3px rgba(0,0,0,.03);transition:border-color var(--t),box-shadow var(--t)}\n    .box:focus-within{border-color:var(--ash);box-shadow:0 4px 16px rgba(0,0,0,.06)}\n    .box .ic{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;color:var(--ash);flex-shrink:0;transition:background var(--t),color var(--t)}\n    .box .ic:hover{background:var(--bubble);color:var(--muted)}\n    .box .ic svg{width:18px;height:18px}\n    textarea{flex:1;resize:none;border:0;outline:0;background:none;font-size:15px;font-family:var(--sans);line-height:1.5;padding:8px 2px;max-height:180px;color:var(--ink);color-scheme:light;-webkit-text-fill-color:var(--ink)}\n    textarea::placeholder{color:var(--ash)}\n    .send{width:36px;height:36px;border-radius:11px;background:var(--ink);color:#fff;display:grid;place-items:center;flex-shrink:0;transition:opacity var(--t),transform var(--t),background var(--t)}\n    .send:disabled{background:var(--line);color:var(--ash);cursor:default}\n    .send:not(:disabled):hover{transform:scale(1.05)}\n    .send svg{width:18px;height:18px}\n    .foot{text-align:center;font-size:11px;color:var(--ash);margin-top:9px}\n    .notice{color:var(--pulse)}\n    @media(max-width:760px){.app{grid-template-columns:0 1fr}.side{border-right:0}}\n  </style>\n</head>\n<body>\n<div class=\"app\" id=\"app\">\n  <aside class=\"side\">\n    <div class=\"sh\">\n      <a class=\"brand\" data-app=\"search\" href=\"/\"><span class=\"wave\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span><span data-brand>noliae</span><span class=\"slash\">AI</span></a>\n    </div>\n    <button class=\"newc\" type=\"button\" id=\"newChat\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"><path d=\"M12 5v14M5 12h14\"></path></svg>Nouvelle discussion</button>\n    <div class=\"convs\" id=\"convs\"></div>\n    <div class=\"sf\"><a data-app=\"account\" href=\"/compte\"><span class=\"av\" id=\"side-av\">·</span><div><div class=\"nm\" id=\"side-name\">…</div><div class=\"rl\" id=\"side-email\"></div></div></a></div>\n  </aside>\n\n  <div class=\"main\">\n    <div class=\"top\">\n      <button class=\"iconbtn\" id=\"toggle\" title=\"Masquer l'historique\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"></rect><path d=\"M9 4v16\"></path></svg></button>\n      <div class=\"cur-model\" id=\"curModelBadge\"></div>\n    </div>\n\n    <div class=\"scroll\" id=\"scroll\">\n      <div class=\"stage\">\n        <div class=\"empty\" id=\"empty\">\n          <div class=\"mark\"><span class=\"wave\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span></div>\n          <div class=\"h\">Comment puis-je vous aider ?</div>\n          <div class=\"sub\">Choisissez un modèle et posez votre question.</div>\n          <div class=\"sugg\" id=\"sugg\">\n            <button type=\"button\">Rédige un e-mail de relance client</button>\n            <button type=\"button\">Explique le WAF en une phrase</button>\n            <button type=\"button\">Idées de nom pour un SaaS</button>\n            <button type=\"button\">Corrige ce texte en français</button>\n          </div>\n        </div>\n        <div class=\"thread\" id=\"thread\" style=\"display:none\"></div>\n      </div>\n    </div>\n\n    <div class=\"dock\">\n      <div class=\"composer\">\n        <div class=\"box\">\n          <button class=\"ic\" id=\"attach\" title=\"Joindre un document\" type=\"button\" disabled><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M21 12.5 12.5 21a5 5 0 0 1-7-7l8.5-8.5a3.5 3.5 0 0 1 5 5L10.5 19a2 2 0 0 1-3-3l8-8\"></path></svg></button>\n          <input type=\"file\" id=\"attachInput\" accept=\".txt,.md,.csv,.json,.log,text/plain\" hidden>\n          <textarea id=\"ta\" rows=\"1\" placeholder=\"Écrivez votre question…\" disabled></textarea>\n          <button class=\"send\" id=\"send\" disabled type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M12 20V5M6 11l6-6 6 6\"></path></svg></button>\n        </div>\n        <div class=\"providers\" id=\"providers\"></div>\n        <div class=\"foot\" id=\"foot\">Noliae AI peut se tromper · vérifiez les informations importantes.</div>\n      </div>\n    </div>\n  </div>\n</div>\n<div class=\"modal-veil\" id=\"modelModalVeil\" hidden>\n  <div class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Choisir un modèle\">\n    <header><h2>Choisir un modèle</h2><button type=\"button\" class=\"iconbtn\" id=\"modelModalClose\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M6 6l12 12M18 6 6 18\"/></svg></button></header>\n    <div class=\"modal-list\" id=\"modelModalList\"></div>\n  </div>\n</div>\n<script src=\"/static/links.js\"></script>\n<script>\n(()=>{\nconst p=location.hostname.split('.'),api=p.length<3?location.origin:location.protocol+'//api.'+p.slice(1).join('.'),\nlogin=p.length<3?'/':location.protocol+'//login.'+p.slice(1).join('.'),\ngoLogin=()=>location.replace(login+'/?return_to='+encodeURIComponent(location.href));\n\nconst LOGOS={\n  chatgpt:'<svg class=\"logo\" viewBox=\"0 0 24 24\"><rect width=\"24\" height=\"24\" rx=\"5\" fill=\"#fff\" stroke=\"#E8E8E3\"/><path fill=\"#0B0B0B\" d=\"M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.8956zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.4592a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654 2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z\"/></svg>',\n  claude:'<svg class=\"logo\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#D97757\"/><path fill=\"#fff\" d=\"M12.4 26.5 17 14.2c.2-.5.6-.7 1.1-.7s.9.3 1.1.7l4.6 12.3c.2.6-.1 1.1-.6 1.3-.6.2-1.1-.1-1.3-.6l-1-2.8h-5.1l-1 2.8c-.2.5-.7.8-1.3.6-.5-.2-.8-.7-.6-1.3Z\"/></svg>',\n  mistral:'<svg class=\"logo\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#0B0B0B\"/><g transform=\"translate(8 11)\"><rect x=\"0\" y=\"0\" width=\"4.6\" height=\"4.6\" fill=\"#FFD800\"/><rect x=\"19.4\" y=\"0\" width=\"4.6\" height=\"4.6\" fill=\"#FFD800\"/><rect x=\"0\" y=\"4.6\" width=\"4.6\" height=\"4.6\" fill=\"#FFAF00\"/><rect x=\"4.8\" y=\"4.6\" width=\"4.6\" height=\"4.6\" fill=\"#FFAF00\"/><rect x=\"14.6\" y=\"4.6\" width=\"4.6\" height=\"4.6\" fill=\"#FFAF00\"/><rect x=\"19.4\" y=\"4.6\" width=\"4.6\" height=\"4.6\" fill=\"#FFAF00\"/><rect x=\"0\" y=\"9.2\" width=\"24\" height=\"4.6\" fill=\"#FF8205\"/><rect x=\"0\" y=\"13.8\" width=\"4.6\" height=\"4.6\" fill=\"#FA500F\"/><rect x=\"9.7\" y=\"13.8\" width=\"4.6\" height=\"4.6\" fill=\"#FA500F\"/><rect x=\"19.4\" y=\"13.8\" width=\"4.6\" height=\"4.6\" fill=\"#FA500F\"/></g></svg>',\n  gemini:'<svg class=\"logo\" viewBox=\"0 0 40 40\"><defs><linearGradient id=\"gg\" x1=\"0\" y1=\"0\" x2=\"40\" y2=\"40\"><stop offset=\"0\" stop-color=\"#4E8CF5\"/><stop offset=\"1\" stop-color=\"#8E5CF6\"/></linearGradient></defs><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#0B0B0B\"/><path fill=\"url(#gg)\" d=\"M20 8c.3 5.5 4.7 9.9 12 12-7.3 2.1-11.7 6.5-12 12-.3-5.5-4.7-9.9-12-12 7.3-2.1 11.7-6.5 12-12Z\"/></svg>'\n};\nconst DEFAULT_LOGO='<svg class=\"logo\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#111\"/><path fill=\"#FF4D2E\" d=\"M12 20c.2-4 3.4-7.2 8-7.4-2.6 1.5-4.2 4.3-4.3 7.4.1 3.1 1.7 5.9 4.3 7.4-4.6-.2-7.8-3.4-8-7.4Z\"/></svg>';\nconst logoFor=provider=>LOGOS[provider]||DEFAULT_LOGO;\n\nlet MODELS=[],curModel=null,PROVIDERS=[];\n// Ordre de préférence par coût (les moins chers en tête) : le premier\n// fournisseur DISPONIBLE de cette liste devient le choix par défaut.\nconst ORDRE_ECONOMIQUE=['mistral','gemini','chatgpt','claude'];\nconst MODEL_KEY='noliae_ai_model_v1';\nfunction setCurModel(m){curModel=m;if(m){try{localStorage.setItem(MODEL_KEY,JSON.stringify({provider:m.provider,model:m.model}))}catch(_){}}}\n\n// L'historique vit en base (table conversations/messages, déjà écrite par\n// /v1/ia à chaque message) : cette liste n'est qu'un cache d'affichage de\n// /v1/conversations, jamais la source de vérité.\nlet chats=[],activeId=null,busy=false;\nasync function loadConvs(){\n  try{\n    const r=await fetch(api+'/v1/conversations',{credentials:'include'});\n    chats=r.ok?await r.json():[];\n  }catch(_){chats=[]}\n  renderConvs();\n}\n\nconst providersEl=document.getElementById('providers');\n// Une pastille par FOURNISSEUR (pas par modèle : la liste complète peut\n// compter des dizaines de variantes) — le premier modèle de chaque\n// fournisseur est déjà son choix « courant » (voir ia_modele_prioritaire\n// côté serveur), donc directement utilisable ici.\nfunction calculerProviders(){\n  const vus=new Set();\n  PROVIDERS=MODELS.filter(m=>{if(vus.has(m.provider))return false;vus.add(m.provider);return true});\n}\nfunction renderProviders(){\n  providersEl.innerHTML=PROVIDERS.map(m=>'<button type=\"button\" class=\"provider '+(curModel&&curModel.provider===m.provider?'on':'')+'\" data-provider=\"'+esc(m.provider)+'\">'+logoFor(m.provider)+'<span>'+esc(m.label||m.provider)+'</span><svg class=\"cv\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"m9 6 6 6-6 6\"/></svg></button>').join('');\n  providersEl.querySelectorAll('.provider').forEach(b=>b.addEventListener('click',()=>openModelModal(b.dataset.provider)));\n  const badge=document.getElementById('curModelBadge');\n  badge.innerHTML=curModel?(logoFor(curModel.provider)+'<span>'+esc(curModel.label||curModel.provider)+'</span>'):'';\n}\n\nconst modelVeil=document.getElementById('modelModalVeil'),modelList=document.getElementById('modelModalList');\nfunction openModelModal(focusProvider){\n  const groupes={};\n  MODELS.forEach(m=>{(groupes[m.provider]=groupes[m.provider]||[]).push(m)});\n  modelList.innerHTML=Object.keys(groupes).map(p=>'<div class=\"modal-group\">'+esc(groupes[p][0].label||p)+'</div>'+groupes[p].map(m=>'<div class=\"modal-opt '+(m===curModel?'on':'')+'\" data-provider=\"'+esc(m.provider)+'\" data-model=\"'+esc(m.model)+'\">'+logoFor(m.provider)+'<div class=\"tx\"><div class=\"nm\">'+esc(m.model)+'</div></div><svg class=\"ck\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12l5 5 9-9\"/></svg></div>').join('')).join('');\n  modelList.querySelectorAll('.modal-opt').forEach(o=>o.addEventListener('click',()=>{\n    setCurModel(MODELS.find(m=>m.provider===o.dataset.provider&&m.model===o.dataset.model)||curModel);\n    renderProviders();closeModelModal();\n  }));\n  modelVeil.hidden=false;\n  if(focusProvider){const first=modelList.querySelector('[data-provider=\"'+focusProvider+'\"]');if(first)first.scrollIntoView({block:'center'})}\n}\nfunction closeModelModal(){modelVeil.hidden=true}\ndocument.getElementById('modelModalClose').addEventListener('click',closeModelModal);\nmodelVeil.addEventListener('click',e=>{if(e.target===modelVeil)closeModelModal()});\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape')closeModelModal()});\n\ndocument.getElementById('toggle').addEventListener('click',()=>document.getElementById('app').classList.toggle('collapsed'));\nfunction renderConvs(){\n  const c=document.getElementById('convs');\n  if(!chats.length){c.innerHTML='<div class=\"dh\">Aucune discussion</div>';return}\n  c.innerHTML='<div class=\"dh\">Récent</div>'+chats.map(ch=>'<div class=\"conv '+(String(ch.id)===String(activeId)?'on':'')+'\" data-id=\"'+ch.id+'\"><span class=\"tt\">'+escAttr(ch.title)+'</span><button class=\"del\" data-del=\"'+ch.id+'\" title=\"Supprimer\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"><path d=\"M6 7h12M9 7V5h6v2M8 7l1 13h6l1-13\"/></svg></button></div>').join('');\n  c.querySelectorAll('.conv').forEach(el=>el.addEventListener('click',()=>openChat(el.dataset.id)));\n  c.querySelectorAll('[data-del]').forEach(b=>b.addEventListener('click',e=>{e.stopPropagation();delChat(b.dataset.del)}));\n}\nasync function delChat(id){\n  if(String(activeId)===String(id))newChat();\n  chats=chats.filter(c=>String(c.id)!==String(id));renderConvs();\n  try{await fetch(api+'/v1/conversations/'+encodeURIComponent(id),{method:'DELETE',credentials:'include'})}catch(_){}\n}\n\nconst thread=document.getElementById('thread'),empty=document.getElementById('empty'),scroll=document.getElementById('scroll'),ta=document.getElementById('ta'),send=document.getElementById('send');\nfunction newChat(){activeId=null;thread.innerHTML='';thread.style.display='none';empty.style.display='';ta.value='';autosize();send.disabled=true;renderConvs()}\ndocument.getElementById('newChat').addEventListener('click',newChat);\nasync function openChat(id){\n  activeId=id;empty.style.display='none';thread.style.display='';thread.innerHTML='';renderConvs();\n  const ch=chats.find(c=>String(c.id)===String(id));\n  if(ch){const m=PROVIDERS.find(p=>p.provider===ch.provider);if(m){curModel=MODELS.find(x=>x.provider===ch.provider&&x.model===ch.model)||m;renderProviders()}}\n  try{\n    const r=await fetch(api+'/v1/conversations/'+encodeURIComponent(id)+'/messages',{credentials:'include'});\n    const msgs=r.ok?await r.json():[];\n    msgs.forEach(m=>renderMsg(m.role,m.role==='user'?esc(m.content).replace(/\\n/g,'<br>'):md(m.content),ch&&ch.provider));\n  }catch(_){}\n  scroll.scrollTop=scroll.scrollHeight;\n}\n\nfunction esc(s){return String(s||'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}\nfunction escAttr(s){return esc(s).replace(/\"/g,'&quot;')}\nfunction md(s){s=esc(s);s=s.replace(/```([\\s\\S]*?)```/g,(m,c)=>'<pre><code>'+c.replace(/^\\n/,'')+'</code></pre>');s=s.replace(/`([^`]+)`/g,'<code>$1</code>');s=s.replace(/\\*\\*([^*]+)\\*\\*/g,'<strong>$1</strong>');const lines=s.split('\\n');let out='',list=null;for(let ln of lines){if(/^\\s*[-*]\\s+/.test(ln)){if(list!=='ul'){out+='<ul>';list='ul'}out+='<li>'+ln.replace(/^\\s*[-*]\\s+/,'')+'</li>'}else if(/^\\s*\\d+\\.\\s+/.test(ln)){if(list!=='ol'){out+='<ol>';list='ol'}out+='<li>'+ln.replace(/^\\s*\\d+\\.\\s+/,'')+'</li>'}else{if(list){out+=list==='ul'?'</ul>':'</ol>';list=null}if(ln.trim())out+='<p>'+ln+'</p>'}}if(list)out+=list==='ul'?'</ul>':'</ol>';return out}\nfunction renderMsg(role,html,provider){\n  const d=document.createElement('div');d.className='msg '+(role==='user'?'u':'a');\n  const ava=role==='user'?(document.getElementById('side-av').textContent):logoFor(provider);\n  const label=MODELS.find(m=>m.provider===provider);\n  d.innerHTML='<div class=\"ava\">'+ava+'</div><div class=\"body\">'+(role==='assistant'?'<div class=\"who\">'+esc(label?(label.label||label.provider):'Noliae AI')+'</div>':'')+html+'</div>';\n  thread.appendChild(d);scroll.scrollTop=scroll.scrollHeight;return d.querySelector('.body')\n}\n\nconst attachBtn=document.getElementById('attach'),attachInput=document.getElementById('attachInput');\nattachBtn.addEventListener('click',()=>attachInput.click());\nattachInput.addEventListener('change',async()=>{\n  const file=attachInput.files[0];attachInput.value='';\n  if(!file)return;\n  const foot=document.getElementById('foot');\n  const avant=foot.textContent;\n  foot.textContent='Envoi de « '+file.name+' »…';\n  try{\n    const content=await file.text();\n    if(!content.trim())throw new Error('Fichier vide.');\n    const r=await fetch(api+'/api/documents',{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify({title:file.name,content})});\n    const data=await r.json().catch(()=>({}));\n    if(!r.ok)throw new Error(data.detail||'Envoi impossible.');\n    foot.textContent='« '+file.name+' » ajouté — le contexte sera utilisé dans vos prochains messages.';\n  }catch(e){foot.textContent=(e instanceof TypeError)?'La connexion à nos serveurs semble bloquée par une extension (bloqueur de publicités/traceurs).':(e.message||'Envoi du document impossible.')}\n  setTimeout(()=>{foot.textContent=avant},4000);\n});\nfunction autosize(){ta.style.height='auto';ta.style.height=Math.min(ta.scrollHeight,180)+'px'}\nta.addEventListener('input',()=>{autosize();send.disabled=!ta.value.trim()||busy});\nta.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();submit()}});\nsend.addEventListener('click',submit);\ndocument.querySelectorAll('#sugg button').forEach(b=>b.addEventListener('click',()=>{ta.value=b.textContent;autosize();send.disabled=false;submit()}));\n\nasync function submit(){\n  const q=ta.value.trim();if(!q||busy||!curModel)return;\n  busy=true;send.disabled=true;\n  const isNew=!activeId;\n  if(isNew){empty.style.display='none';thread.style.display=''}\n  renderMsg('user',esc(q).replace(/\\n/g,'<br>'));\n  ta.value='';autosize();\n  const provider=curModel.provider;\n  const body=renderMsg('assistant','<div class=\"dots\"><i></i><i></i><i></i></div>',provider);\n  try{\n    const r=await fetch(api+'/v1/ia',{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify({message:q,provider:curModel.provider,model:curModel.model,conversation_id:activeId||undefined})});\n    const data=await r.json().catch(()=>({}));\n    if(!r.ok)throw data;\n    activeId=data.conversation_id||activeId;\n    body.innerHTML='<div class=\"who\">'+esc(curModel.label||curModel.provider)+'</div>'+md(data.answer||'Aucune réponse reçue.');\n    // Nouvelle conversation ou historique désynchronisé : on relit la liste\n    // côté serveur plutôt que de deviner le titre/tri localement.\n    await loadConvs();\n  }catch(e){body.innerHTML='<p style=\"color:var(--pulse)\">'+esc((e instanceof TypeError)?'La connexion à nos serveurs semble bloquée par une extension (bloqueur de publicités/traceurs). Désactive-la pour ce site, ou essaie en navigation privée, puis réessaie.':((e&&e.detail)||'Une erreur est survenue. Réessayez dans un instant.'))+'</p>'}\n  scroll.scrollTop=scroll.scrollHeight;\n  busy=false;send.disabled=!ta.value.trim();ta.focus()\n}\n\nfetch(api+'/v1/user/me',{credentials:'include'}).then(async r=>{if(!r.ok)throw 0;return r.json()}).then(user=>{\n  document.getElementById('side-av').textContent=(user.name||user.email||'?').slice(0,2).toUpperCase();\n  document.getElementById('side-name').textContent=user.name||user.email;\n  document.getElementById('side-email').textContent=user.email;\n  return fetch(api+'/v1/ia/models',{credentials:'include'});\n}).then(async r=>{\n  const data=await r.json().catch(()=>[]);\n  MODELS=Array.isArray(data)?data:(Array.isArray(data.models)?data.models:[]);\n  if(!MODELS.length)throw 0;\n  calculerProviders();\n  let restaure=null;\n  try{const saved=JSON.parse(localStorage.getItem(MODEL_KEY)||'null');if(saved)restaure=MODELS.find(m=>m.provider===saved.provider&&m.model===saved.model)}catch(_){}\n  const parEconomie=ORDRE_ECONOMIQUE.map(p=>PROVIDERS.find(m=>m.provider===p)).find(Boolean);\n  setCurModel(restaure||parEconomie||PROVIDERS[0]);\n  renderProviders();\n  ta.disabled=false;document.getElementById('attach').disabled=false;loadConvs();\n}).catch(()=>{ if(!MODELS.length){ goLogin(); } });\n})();\n</script>\n</body></html>\n"
    return _o
}
