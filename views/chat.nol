fn vue_chat(titre: Text, message: Text, answer: Text) -> Text {
    var _o = ""
    _o += "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#fafaf7\">\n  <title>"
    _o += html_escape(titre)
    _o += "</title>\n  <link rel=\"stylesheet\" href=\"/static/noliae.css\">\n  <style>\n    :root{--ash:#8A8A85;--paper-2:#fff;--bubble:#F4F4F0;--sidebg:#F4F4F0;--t:.18s;--ease:cubic-bezier(.6,.05,.25,1);--side-w:262px}\n    *,*::before,*::after{box-sizing:border-box}\n    html,body{height:100%;margin:0}\n    body{font-family:var(--sans);background:var(--paper);color:var(--ink);font-size:15px;overflow:hidden}\n    button{background:none;border:0;padding:0;margin:0;cursor:pointer;color:inherit;font:inherit}\n    .app{display:grid;grid-template-columns:var(--side-w) 1fr;height:100vh;transition:grid-template-columns var(--t) var(--ease)}\n    .app.collapsed{grid-template-columns:0 1fr}\n    .side{background:var(--sidebg);border-right:1px solid var(--line);display:flex;flex-direction:column;overflow:hidden;min-width:0}\n    .side .sh{display:flex;align-items:center;justify-content:space-between;padding:14px 14px 10px}\n    .side .brand{display:flex;align-items:center;gap:9px;font-family:var(--mono);font-weight:500;font-size:15px;letter-spacing:-.05em;color:var(--ink);text-decoration:none}\n    .side .brand .wave{gap:2px}\n    .side .brand .wave i{width:3px;background:var(--ink);border-radius:4px}\n    .side .brand .wave i:nth-child(1),.side .brand .wave i:nth-child(7){height:7px}\n    .side .brand .wave i:nth-child(2),.side .brand .wave i:nth-child(6){height:12px}\n    .side .brand .wave i:nth-child(3),.side .brand .wave i:nth-child(5){height:16px}\n    .side .brand .wave i:nth-child(4){height:20px;background:var(--pulse)}\n    .side .slash{font-family:var(--mono);font-size:8px;letter-spacing:.16em;text-transform:uppercase;color:var(--pulse);padding:3px 6px;border:1px solid rgba(255,77,46,.4);border-radius:100px}\n    .newc{display:flex;align-items:center;gap:9px;margin:2px 12px 12px;padding:10px 12px;border:1px solid var(--line);background:var(--paper-2);border-radius:10px;font-size:13.5px;font-weight:500;transition:border-color var(--t),box-shadow var(--t)}\n    .newc:hover{border-color:var(--ash);box-shadow:0 1px 4px rgba(0,0,0,.04)}\n    .newc svg{width:16px;height:16px}\n    .convs{flex:1;overflow-y:auto;padding:2px 8px 12px}\n    .convs .dh{font-family:var(--mono);font-size:8.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--ash);padding:12px 8px 6px}\n    .conv{display:flex;align-items:center;gap:8px;padding:9px 10px;border-radius:8px;cursor:pointer;color:var(--muted);font-size:13.5px;transition:background var(--t),color var(--t);position:relative}\n    .conv:hover{background:rgba(0,0,0,.045);color:var(--ink)}\n    .conv.on{background:var(--paper-2);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.05)}\n    .conv .tt{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .conv .del{opacity:0;width:22px;height:22px;border-radius:6px;display:grid;place-items:center;color:var(--ash);flex-shrink:0;transition:opacity var(--t),background var(--t),color var(--t)}\n    .conv:hover .del{opacity:1}\n    .conv .del:hover{background:#FFE9E2;color:var(--pulse)}\n    .conv .del svg{width:13px;height:13px}\n    .side .sf{padding:12px;border-top:1px solid var(--line);display:flex;align-items:center;gap:10px}\n    .side .sf a{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit;flex:1;min-width:0}\n    .side .sf .av{width:28px;height:28px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-family:var(--mono);font-size:11px;font-weight:500;flex-shrink:0}\n    .side .sf .nm{font-size:12.5px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .side .sf .rl{font-size:11px;color:var(--ash);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .main{display:flex;flex-direction:column;min-width:0;overflow:hidden}\n    .top{height:52px;display:flex;align-items:center;gap:12px;padding:0 16px;flex-shrink:0}\n    .iconbtn{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;color:var(--muted);transition:background var(--t)}\n    .iconbtn:hover{background:var(--bubble)}\n    .iconbtn svg{width:18px;height:18px}\n    .cur-model{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:500;color:var(--muted)}\n    .cur-model .logo{width:17px;height:17px}\n    .logo{width:19px;height:19px;flex-shrink:0;display:block;border-radius:5px}\n    .providers{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:6px;margin-top:9px}\n    .provider{display:flex;align-items:center;gap:6px;padding:6px 8px 6px 10px;border:1px solid var(--line);border-radius:100px;font-size:12px;font-weight:500;background:var(--paper-2);color:var(--muted);opacity:.65;transition:border-color var(--t),color var(--t),background var(--t),opacity var(--t)}\n    .provider:hover{border-color:var(--ash);color:var(--ink);opacity:1}\n    .provider.on{border-color:var(--ink);color:var(--ink);opacity:1}\n    .provider .logo{width:15px;height:15px}\n    .provider .cv{width:12px;height:12px;color:var(--ash)}\n    .scroll{flex:1;overflow-y:auto}\n    .stage{width:100%;max-width:720px;margin:0 auto;padding:0 24px;min-height:100%;display:flex;flex-direction:column}\n    .empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding-bottom:8vh}\n    .empty .mark{filter:drop-shadow(0 4px 10px rgba(0,0,0,.08));animation:float 4.5s var(--ease) infinite}\n    .empty .mark .wave{gap:4px}\n    .empty .mark .wave i{width:8px;background:var(--ink);border-radius:5px}\n    .empty .mark .wave i:nth-child(1),.empty .mark .wave i:nth-child(7){height:24px}\n    .empty .mark .wave i:nth-child(2),.empty .mark .wave i:nth-child(6){height:40px}\n    .empty .mark .wave i:nth-child(3),.empty .mark .wave i:nth-child(5){height:56px}\n    .empty .mark .wave i:nth-child(4){height:70px;background:var(--pulse)}\n    @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}\n    .empty .h{font-size:22px;font-weight:500;letter-spacing:-.02em}\n    .empty .sub{font-size:14px;color:var(--ash);margin-top:-8px}\n    .sugg{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;max-width:520px;margin-top:6px}\n    .sugg button{font-size:12.5px;color:var(--muted);padding:8px 13px;border:1px solid var(--line);border-radius:100px;background:var(--paper-2);transition:border-color var(--t),color var(--t),transform var(--t)}\n    .sugg button:hover{border-color:var(--ash);color:var(--ink);transform:translateY(-1px)}\n    .thread{padding:22px 0 20px;display:flex;flex-direction:column;gap:22px}\n    .msg{display:flex;gap:12px}\n    .msg .ava{width:26px;height:26px;border-radius:7px;flex-shrink:0;display:grid;place-items:center;overflow:hidden}\n    .msg.u .ava{background:var(--ink);color:#fff;font-family:var(--mono);font-size:10px;font-weight:500;border-radius:50%}\n    .msg .ava .logo{width:26px;height:26px;border-radius:7px}\n    .msg .body{padding-top:2px;line-height:1.62;flex:1;min-width:0;color:var(--carbon)}\n    .msg .body p{margin:0 0 10px}.msg .body p:last-child{margin:0}\n    .msg .body ul,.msg .body ol{margin:0 0 10px;padding-left:20px}\n    .msg .body li{margin:3px 0}\n    .msg .body code{font-family:var(--mono);font-size:.86em;background:var(--bubble);padding:1px 5px;border-radius:4px}\n    .msg .body pre{background:var(--bubble);border:1px solid var(--line);border-radius:8px;padding:12px 14px;overflow-x:auto;margin:0 0 10px}\n    .msg .body pre code{background:none;padding:0;font-size:12.5px;line-height:1.55}\n    .msg .body strong{font-weight:600}\n    .msg .who{font-size:11px;color:var(--ash);font-weight:500;margin-bottom:3px}\n    .dots{display:inline-flex;gap:4px;padding-top:6px}\n    .dots i{width:6px;height:6px;border-radius:50%;background:var(--ash);animation:bl 1.2s infinite}\n    .dots i:nth-child(2){animation-delay:.2s}.dots i:nth-child(3){animation-delay:.4s}\n    @keyframes bl{0%,60%,100%{opacity:.25}30%{opacity:1}}\n    .dock{flex-shrink:0;padding:10px 24px 20px;background:linear-gradient(to top,var(--paper) 66%,transparent)}\n    .composer{width:100%;max-width:720px;margin:0 auto}\n    .box{display:flex;align-items:flex-end;gap:8px;background:var(--paper-2);border:1px solid var(--line);border-radius:16px;padding:8px 8px 8px 14px;box-shadow:0 1px 3px rgba(0,0,0,.03);transition:border-color var(--t),box-shadow var(--t)}\n    .box:focus-within{border-color:var(--ash);box-shadow:0 4px 16px rgba(0,0,0,.06)}\n    .box .ic{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;color:var(--ash);flex-shrink:0;transition:background var(--t),color var(--t)}\n    .box .ic:hover{background:var(--bubble);color:var(--muted)}\n    .box .ic svg{width:18px;height:18px}\n    textarea{flex:1;resize:none;border:0;outline:0;background:none;font-size:15px;font-family:var(--sans);line-height:1.5;padding:8px 2px;max-height:180px;color:var(--ink)}\n    textarea::placeholder{color:var(--ash)}\n    .send{width:36px;height:36px;border-radius:11px;background:var(--ink);color:#fff;display:grid;place-items:center;flex-shrink:0;transition:opacity var(--t),transform var(--t),background var(--t)}\n    .send:disabled{background:var(--line);color:var(--ash);cursor:default}\n    .send:not(:disabled):hover{transform:scale(1.05)}\n    .send svg{width:18px;height:18px}\n    .foot{text-align:center;font-size:11px;color:var(--ash);margin-top:9px}\n    .notice{color:var(--pulse)}\n    @media(max-width:760px){.app{grid-template-columns:0 1fr}.side{border-right:0}}\n  </style>\n</head>\n<body>\n<div class=\"app\" id=\"app\">\n  <aside class=\"side\">\n    <div class=\"sh\">\n      <a class=\"brand\" data-app=\"search\" href=\"/\"><span class=\"wave\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span><span data-brand>noliae</span><span class=\"slash\">AI</span></a>\n    </div>\n    <button class=\"newc\" type=\"button\" id=\"newChat\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"><path d=\"M12 5v14M5 12h14\"></path></svg>Nouvelle discussion</button>\n    <div class=\"convs\" id=\"convs\"></div>\n    <div class=\"sf\"><a data-app=\"account\" href=\"/compte\"><span class=\"av\" id=\"side-av\">·</span><div><div class=\"nm\" id=\"side-name\">…</div><div class=\"rl\" id=\"side-email\"></div></div></a></div>\n  </aside>\n\n  <div class=\"main\">\n    <div class=\"top\">\n      <button class=\"iconbtn\" id=\"toggle\" title=\"Masquer l'historique\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"></rect><path d=\"M9 4v16\"></path></svg></button>\n      <div class=\"cur-model\" id=\"curModelBadge\"></div>\n    </div>\n\n    <div class=\"scroll\" id=\"scroll\">\n      <div class=\"stage\">\n        <div class=\"empty\" id=\"empty\">\n          <div class=\"mark\"><span class=\"wave\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span></div>\n          <div class=\"h\">Comment puis-je vous aider ?</div>\n          <div class=\"sub\">Choisissez un modèle et posez votre question.</div>\n          <div class=\"sugg\" id=\"sugg\">\n            <button type=\"button\">Rédige un e-mail de relance client</button>\n            <button type=\"button\">Explique le WAF en une phrase</button>\n            <button type=\"button\">Idées de nom pour un SaaS</button>\n            <button type=\"button\">Corrige ce texte en français</button>\n          </div>\n        </div>\n        <div class=\"thread\" id=\"thread\" style=\"display:none\"></div>\n      </div>\n    </div>\n\n    <div class=\"dock\">\n      <div class=\"composer\">\n        <div class=\"box\">\n          <textarea id=\"ta\" rows=\"1\" placeholder=\"Écrivez votre question…\" disabled></textarea>\n          <button class=\"send\" id=\"send\" disabled type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M12 20V5M6 11l6-6 6 6\"></path></svg></button>\n        </div>\n        <div class=\"providers\" id=\"providers\"></div>\n        <div class=\"foot\" id=\"foot\">Noliae AI peut se tromper · vérifiez les informations importantes.</div>\n      </div>\n    </div>\n  </div>\n</div>\n<script src=\"/static/links.js\"></script>\n<script>\n(()=>{\nconst p=location.hostname.split('.'),api=p.length<3?location.origin:location.protocol+'//api.'+p.slice(1).join('.'),\nlogin=p.length<3?'/':location.protocol+'//login.'+p.slice(1).join('.'),\ngoLogin=()=>location.replace(login+'/?return_to='+encodeURIComponent(location.href));\n\nconst LOGOS={\n  chatgpt:'<svg class=\"logo\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#0F9D77\"/><path fill=\"#fff\" d=\"M27.8 18.3a5.2 5.2 0 0 0-.45-4.27 5.28 5.28 0 0 0-5.68-2.53 5.24 5.24 0 0 0-3.96-1.76 5.27 5.27 0 0 0-5.02 3.64 5.23 5.23 0 0 0-3.5 2.54 5.28 5.28 0 0 0 .65 6.19 5.2 5.2 0 0 0 .45 4.27 5.28 5.28 0 0 0 5.68 2.53 5.23 5.23 0 0 0 3.96 1.76 5.27 5.27 0 0 0 5.02-3.65 5.23 5.23 0 0 0 3.5-2.53 5.28 5.28 0 0 0-.65-6.19Z\"/></svg>',\n  claude:'<svg class=\"logo\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#D97757\"/><path fill=\"#fff\" d=\"M12.4 26.5 17 14.2c.2-.5.6-.7 1.1-.7s.9.3 1.1.7l4.6 12.3c.2.6-.1 1.1-.6 1.3-.6.2-1.1-.1-1.3-.6l-1-2.8h-5.1l-1 2.8c-.2.5-.7.8-1.3.6-.5-.2-.8-.7-.6-1.3Z\"/></svg>',\n  mistral:'<svg class=\"logo\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#0B0B0B\"/><g transform=\"translate(8 11)\"><rect x=\"0\" y=\"0\" width=\"4.6\" height=\"4.6\" fill=\"#FFD800\"/><rect x=\"19.4\" y=\"0\" width=\"4.6\" height=\"4.6\" fill=\"#FFD800\"/><rect x=\"0\" y=\"4.6\" width=\"4.6\" height=\"4.6\" fill=\"#FFAF00\"/><rect x=\"4.8\" y=\"4.6\" width=\"4.6\" height=\"4.6\" fill=\"#FFAF00\"/><rect x=\"14.6\" y=\"4.6\" width=\"4.6\" height=\"4.6\" fill=\"#FFAF00\"/><rect x=\"19.4\" y=\"4.6\" width=\"4.6\" height=\"4.6\" fill=\"#FFAF00\"/><rect x=\"0\" y=\"9.2\" width=\"24\" height=\"4.6\" fill=\"#FF8205\"/><rect x=\"0\" y=\"13.8\" width=\"4.6\" height=\"4.6\" fill=\"#FA500F\"/><rect x=\"9.7\" y=\"13.8\" width=\"4.6\" height=\"4.6\" fill=\"#FA500F\"/><rect x=\"19.4\" y=\"13.8\" width=\"4.6\" height=\"4.6\" fill=\"#FA500F\"/></g></svg>',\n  gemini:'<svg class=\"logo\" viewBox=\"0 0 40 40\"><defs><linearGradient id=\"gg\" x1=\"0\" y1=\"0\" x2=\"40\" y2=\"40\"><stop offset=\"0\" stop-color=\"#4E8CF5\"/><stop offset=\"1\" stop-color=\"#8E5CF6\"/></linearGradient></defs><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#0B0B0B\"/><path fill=\"url(#gg)\" d=\"M20 8c.3 5.5 4.7 9.9 12 12-7.3 2.1-11.7 6.5-12 12-.3-5.5-4.7-9.9-12-12 7.3-2.1 11.7-6.5 12-12Z\"/></svg>'\n};\nconst DEFAULT_LOGO='<svg class=\"logo\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"9\" fill=\"#111\"/><path fill=\"#FF4D2E\" d=\"M12 20c.2-4 3.4-7.2 8-7.4-2.6 1.5-4.2 4.3-4.3 7.4.1 3.1 1.7 5.9 4.3 7.4-4.6-.2-7.8-3.4-8-7.4Z\"/></svg>';\nconst logoFor=provider=>LOGOS[provider]||DEFAULT_LOGO;\n\nlet MODELS=[],curModel=null,PROVIDERS=[];\n// Ordre de préférence par coût (les moins chers en tête) : le premier\n// fournisseur DISPONIBLE de cette liste devient le choix par défaut.\nconst ORDRE_ECONOMIQUE=['mistral','gemini','chatgpt','claude'];\n\nconst KEY='noliae_ai_chats_v1';\nlet chats=JSON.parse(localStorage.getItem(KEY)||'[]');\nlet activeId=null,busy=false;\nfunction save(){localStorage.setItem(KEY,JSON.stringify(chats))}\nfunction active(){return chats.find(c=>c.id===activeId)}\n\nconst providersEl=document.getElementById('providers');\n// Une pastille par FOURNISSEUR (pas par modèle : la liste complète peut\n// compter des dizaines de variantes) — le premier modèle de chaque\n// fournisseur est déjà son choix « courant » (voir ia_modele_prioritaire\n// côté serveur), donc directement utilisable ici.\nfunction calculerProviders(){\n  const vus=new Set();\n  PROVIDERS=MODELS.filter(m=>{if(vus.has(m.provider))return false;vus.add(m.provider);return true});\n}\nfunction renderProviders(){\n  providersEl.innerHTML=PROVIDERS.map(m=>'<button type=\"button\" class=\"provider '+(m===curModel?'on':'')+'\" data-provider=\"'+esc(m.provider)+'\">'+logoFor(m.provider)+'<span>'+esc(m.label||m.provider)+'</span><svg class=\"cv\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"m9 6 6 6-6 6\"/></svg></button>').join('');\n  providersEl.querySelectorAll('.provider').forEach(b=>b.addEventListener('click',()=>{curModel=PROVIDERS.find(m=>m.provider===b.dataset.provider);renderProviders()}));\n  const badge=document.getElementById('curModelBadge');\n  badge.innerHTML=curModel?(logoFor(curModel.provider)+'<span>'+esc(curModel.label||curModel.provider)+'</span>'):'';\n}\n\ndocument.getElementById('toggle').addEventListener('click',()=>document.getElementById('app').classList.toggle('collapsed'));\nfunction renderConvs(){\n  const c=document.getElementById('convs');\n  if(!chats.length){c.innerHTML='<div class=\"dh\">Aucune discussion</div>';return}\n  c.innerHTML='<div class=\"dh\">Récent</div>'+chats.map(ch=>'<div class=\"conv '+(ch.id===activeId?'on':'')+'\" data-id=\"'+ch.id+'\"><span class=\"tt\">'+escAttr(ch.title)+'</span><button class=\"del\" data-del=\"'+ch.id+'\" title=\"Supprimer\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"><path d=\"M6 7h12M9 7V5h6v2M8 7l1 13h6l1-13\"/></svg></button></div>').join('');\n  c.querySelectorAll('.conv').forEach(el=>el.addEventListener('click',()=>openChat(el.dataset.id)));\n  c.querySelectorAll('[data-del]').forEach(b=>b.addEventListener('click',e=>{e.stopPropagation();delChat(b.dataset.del)}));\n}\nfunction delChat(id){chats=chats.filter(c=>c.id!==id);if(activeId===id){activeId=null;newChat()}save();renderConvs()}\n\nconst thread=document.getElementById('thread'),empty=document.getElementById('empty'),scroll=document.getElementById('scroll'),ta=document.getElementById('ta'),send=document.getElementById('send');\nfunction newChat(){activeId=null;thread.innerHTML='';thread.style.display='none';empty.style.display='';ta.value='';autosize();send.disabled=true;renderConvs()}\ndocument.getElementById('newChat').addEventListener('click',newChat);\nfunction openChat(id){activeId=id;const ch=active();empty.style.display='none';thread.style.display='';thread.innerHTML='';ch.msgs.forEach(m=>renderMsg(m.role,m.role==='user'?esc(m.content).replace(/\\n/g,'<br>'):md(m.content),m.provider));scroll.scrollTop=scroll.scrollHeight;renderConvs()}\n\nfunction esc(s){return String(s||'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}\nfunction escAttr(s){return esc(s).replace(/\"/g,'&quot;')}\nfunction md(s){s=esc(s);s=s.replace(/```([\\s\\S]*?)```/g,(m,c)=>'<pre><code>'+c.replace(/^\\n/,'')+'</code></pre>');s=s.replace(/`([^`]+)`/g,'<code>$1</code>');s=s.replace(/\\*\\*([^*]+)\\*\\*/g,'<strong>$1</strong>');const lines=s.split('\\n');let out='',list=null;for(let ln of lines){if(/^\\s*[-*]\\s+/.test(ln)){if(list!=='ul'){out+='<ul>';list='ul'}out+='<li>'+ln.replace(/^\\s*[-*]\\s+/,'')+'</li>'}else if(/^\\s*\\d+\\.\\s+/.test(ln)){if(list!=='ol'){out+='<ol>';list='ol'}out+='<li>'+ln.replace(/^\\s*\\d+\\.\\s+/,'')+'</li>'}else{if(list){out+=list==='ul'?'</ul>':'</ol>';list=null}if(ln.trim())out+='<p>'+ln+'</p>'}}if(list)out+=list==='ul'?'</ul>':'</ol>';return out}\nfunction renderMsg(role,html,provider){\n  const d=document.createElement('div');d.className='msg '+(role==='user'?'u':'a');\n  const ava=role==='user'?(document.getElementById('side-av').textContent):logoFor(provider);\n  const label=MODELS.find(m=>m.provider===provider);\n  d.innerHTML='<div class=\"ava\">'+ava+'</div><div class=\"body\">'+(role==='assistant'?'<div class=\"who\">'+esc(label?(label.label||label.provider):'Noliae AI')+'</div>':'')+html+'</div>';\n  thread.appendChild(d);scroll.scrollTop=scroll.scrollHeight;return d.querySelector('.body')\n}\n\nfunction autosize(){ta.style.height='auto';ta.style.height=Math.min(ta.scrollHeight,180)+'px'}\nta.addEventListener('input',()=>{autosize();send.disabled=!ta.value.trim()||busy});\nta.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();submit()}});\nsend.addEventListener('click',submit);\ndocument.querySelectorAll('#sugg button').forEach(b=>b.addEventListener('click',()=>{ta.value=b.textContent;autosize();send.disabled=false;submit()}));\n\nasync function submit(){\n  const q=ta.value.trim();if(!q||busy||!curModel)return;\n  busy=true;send.disabled=true;\n  if(!activeId){const id='c'+Date.now();chats.unshift({id,title:q.slice(0,42),convId:'',msgs:[]});activeId=id;empty.style.display='none';thread.style.display=''}\n  const ch=active();\n  ch.msgs.push({role:'user',content:q});save();renderConvs();\n  renderMsg('user',esc(q).replace(/\\n/g,'<br>'));\n  ta.value='';autosize();\n  const provider=curModel.provider;\n  const body=renderMsg('assistant','<div class=\"dots\"><i></i><i></i><i></i></div>',provider);\n  try{\n    const r=await fetch(api+'/v1/ia',{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify({message:q,provider:curModel.provider,model:curModel.model,conversation_id:ch.convId||undefined})});\n    const data=await r.json().catch(()=>({}));\n    if(!r.ok)throw data;\n    ch.convId=data.conversation_id||ch.convId;\n    ch.msgs.push({role:'assistant',content:data.answer||'',provider});save();\n    body.innerHTML='<div class=\"who\">'+esc(curModel.label||curModel.provider)+'</div>'+md(data.answer||'Aucune réponse reçue.');\n  }catch(e){body.innerHTML='<p style=\"color:var(--pulse)\">'+esc((e instanceof TypeError)?'La connexion à nos serveurs semble bloquée par une extension (bloqueur de publicités/traceurs). Désactive-la pour ce site, ou essaie en navigation privée, puis réessaie.':((e&&e.detail)||'Une erreur est survenue. Réessayez dans un instant.'))+'</p>'}\n  scroll.scrollTop=scroll.scrollHeight;\n  busy=false;send.disabled=!ta.value.trim();ta.focus()\n}\n\nfetch(api+'/v1/user/me',{credentials:'include'}).then(async r=>{if(!r.ok)throw 0;return r.json()}).then(user=>{\n  document.getElementById('side-av').textContent=(user.name||user.email||'?').slice(0,2).toUpperCase();\n  document.getElementById('side-name').textContent=user.name||user.email;\n  document.getElementById('side-email').textContent=user.email;\n  return fetch(api+'/v1/ia/models',{credentials:'include'});\n}).then(async r=>{\n  const data=await r.json().catch(()=>[]);\n  MODELS=Array.isArray(data)?data:(Array.isArray(data.models)?data.models:[]);\n  if(!MODELS.length)throw 0;\n  calculerProviders();\n  const parEconomie=ORDRE_ECONOMIQUE.map(p=>PROVIDERS.find(m=>m.provider===p)).find(Boolean);\n  curModel=parEconomie||PROVIDERS[0];\n  renderProviders();\n  ta.disabled=false;renderConvs();\n}).catch(()=>{ if(!MODELS.length){ goLogin(); } });\n})();\n</script>\n</body></html>\n"
    return _o
}
