fn vue_chat(titre: Text, message: Text, answer: Text) -> Text {
    var _o = ""
    _o += "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#111111\">\n  <title>"
    _o += html_escape(titre)
    _o += " — Conversations</title>\n  <meta name=\"description\" content=\"Noliae IA : un espace conversationnel multi-modèles relié au Core Noliae.\">\n  <meta name=\"robots\" content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\">\n  <link rel=\"canonical\" href=\"https://ia.noliae.com/\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:locale\" content=\"fr_FR\">\n  <meta property=\"og:site_name\" content=\"Noliae IA\">\n  <meta property=\"og:title\" content=\"Noliae IA — Une pensée, plusieurs voix\">\n  <meta property=\"og:description\" content=\"Un espace conversationnel multi-modèles relié au Core Noliae.\">\n  <meta property=\"og:url\" content=\"https://ia.noliae.com/\">\n  <meta name=\"twitter:card\" content=\"summary\">\n  <meta name=\"twitter:title\" content=\"Noliae IA — Une pensée, plusieurs voix\">\n  <meta name=\"twitter:description\" content=\"Un espace conversationnel multi-modèles relié au Core Noliae.\">\n  <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebApplication\",\"name\":\"Noliae IA\",\"url\":\"https://ia.noliae.com/\",\"applicationCategory\":\"BusinessApplication\",\"operatingSystem\":\"Web\"}</script>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link rel=\"stylesheet\" href=\"/static/noliae.css\">\n  <style>@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}@keyframes level{50%{transform:scaleY(.6);opacity:.55}}.welcome>*{animation:rise .62s cubic-bezier(.2,.8,.2,1) both}.welcome h1{animation-delay:.08s}.welcome>p:not(.cap){animation-delay:.16s}.prompts{animation-delay:.24s}.agent-setup{animation:rise .62s cubic-bezier(.2,.8,.2,1) .3s both}.wave i:nth-child(4){animation:level 1.5s ease-in-out infinite}.sidebar a,.prompts button,.setup-cards button,.model-row label{transition:transform .18s ease,border-color .18s ease,background .18s ease}.prompts button:hover,.setup-cards button:hover{transform:translateY(-2px);border-color:#111}.model-row label:hover{border-color:#FF4D2E}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}</style>\n  <style>.agent-setup{display:flex;align-items:center;gap:14px;margin:28px 0 20px}.agent-symbol{color:#FF4D2E;font:26px ui-monospace,monospace;letter-spacing:-8px;width:44px}.setup-cards{display:flex;gap:9px;flex:1}.setup-cards button{background:#fff;color:#111;border:1px solid #E4E4DF;padding:12px;text-align:left;min-width:190px}.setup-cards small{display:block;font:9px ui-monospace,monospace;letter-spacing:.11em;color:#777}.setup-cards strong{display:block;font-size:12px;margin:5px 0}.setup-cards span{font-size:10px;color:#777}.composer-tools{display:flex;align-items:center;gap:8px;padding:3px 4px 8px}.composer-tools button{background:transparent!important;color:#777!important;border:0;padding:3px;font:15px ui-monospace,monospace}.composer-tools span{font-size:10px;color:#777}.model-row{display:flex;align-items:center;gap:6px;overflow:auto;padding:7px 2px;border-top:1px solid #E4E4DF}.model-row>span{font:9px ui-monospace,monospace;letter-spacing:.1em;color:#777}.model-row label{white-space:nowrap;border:1px solid #E4E4DF;border-radius:99px;padding:4px 8px;font-size:10px;cursor:pointer}.model-row input{accent-color:#FF4D2E;width:10px;height:10px}.composer footer{border-top:0!important;padding-top:1px!important}</style>\n</head>\n<body>\n  <header class=\"appbar\">\n    <a class=\"brand\" href=\"/\"><span class=\"wave\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span> noliae <b>ia</b></a>\n    <div class=\"breadcrumbs\"><span>Noliae</span><i>/</i><strong>Conversations</strong></div>\n    <nav><a href=\"https://noliae.com\">Search</a><a href=\"/compte\">Compte</a><span class=\"avatar\">NL</span></nav>\n  </header>\n  <main>\n    <aside class=\"sidebar\">\n      <div class=\"workspace\"><span class=\"avatar large\">NL</span><div><strong>Mon espace</strong><small><i></i> Noliae personnel</small></div><b>⌄</b></div>\n      <p class=\"cap\">Espace IA</p>\n      <a class=\"active\" href=\"/\"><span>✦</span> Nouvelle discussion</a>\n      <a href=\"#conversations\"><span>◷</span> Conversations récentes</a>\n      <a href=\"#modeles\"><span>◇</span> Explorer les modèles</a>\n      <p class=\"cap lower\">Outils</p>\n      <a href=\"https://noliae.com\"><span>⌕</span> Recherche Noliae</a>\n      <a href=\"/parametres\"><span>⚙</span> Préférences</a>\n      <div class=\"sidebar-foot\"><p><i></i> Core connecté</p><span>Vos droits et votre session sont vérifiés par NolCore.</span></div>\n    </aside>\n    <section class=\"chat\" id=\"conversations\">\n      <div class=\"welcome\">\n        <p class=\"cap\"><i></i> Noliae IA <span>·</span> Conversation</p>\n        <h1>Une pensée,<br><em>plusieurs voix.</em></h1>\n        <p>Choisissez un modèle, posez une question et gardez votre travail relié à votre espace Noliae.</p>\n        <div class=\"prompts\"><button type=\"button\">Explique-moi un concept simplement</button><button type=\"button\">Aide-moi à structurer cette idée</button><button type=\"button\">Résume ce texte</button></div>\n        <section class=\"agent-setup\" id=\"modeles\">\n          <div class=\"agent-symbol\">▂<b>█</b>▂</div>\n          <div class=\"setup-cards\"><button type=\"button\"><small>INSTRUCTIONS</small><strong>Définir le comportement</strong><span>Personnalisez cet assistant</span></button><button type=\"button\"><small>CONTEXTE</small><strong>Ajouter des documents <b>＋</b></strong><span>Vos fichiers restent dans Noliae</span></button></div>\n        </section>\n      </div>\n      <div class=\"conversation\" aria-live=\"polite\">\n        "
    if message != "" {
    _o += "\n          <article class=\"user\"><small>Vous <span>Maintenant</span></small><p>"
    _o += html_escape(message)
    _o += "</p></article>\n          <article><small>Noliae IA <span>Modèle sélectionné</span></small><p>"
    _o += html_escape(answer)
    _o += "</p><footer><button type=\"button\">Copier</button><button type=\"button\">Recommencer</button></footer></article>\n        "
    }
    _o += "\n      </div>\n      <form class=\"composer\" action=\"/discussion\" method=\"post\">\n        <label class=\"sr-only\" for=\"message\">Votre message</label>\n        <textarea id=\"message\" name=\"message\" placeholder=\"Écrivez votre message…\" required></textarea>\n        <div class=\"composer-tools\"><button type=\"button\" aria-label=\"Joindre un fichier\">⌕</button><button type=\"button\" aria-label=\"Image\">▧</button><span>Ajoutez un contexte ou une pièce jointe</span></div>\n        <div class=\"model-row\" aria-label=\"Modèles disponibles\"><span>MODÈLES</span><label><input type=\"radio\" name=\"model\" value=\"chatgpt|gpt-4o-mini\" checked> ChatGPT</label><label><input type=\"radio\" name=\"model\" value=\"claude|claude-3-5-sonnet-latest\"> Claude</label><label><input type=\"radio\" name=\"model\" value=\"mistral|mistral-small-latest\"> Mistral</label><label><input type=\"radio\" name=\"model\" value=\"gemini|gemini-1.5-flash\"> Gemini</label></div>\n        <footer><span>Les réponses sont générées par IA · accès contrôlé par NolCore</span><button>Envoyer <b>↑</b></button></footer>\n      </form>\n    </section>\n  </main>\n  <footer class=\"legal\">© Noliae · Les réponses peuvent contenir des erreurs. Vérifiez toujours les informations importantes. <span>IA / 01</span></footer>\n</body>\n<script>(async()=>{const h=location.hostname;const a=h.startsWith(\"ia.\")?location.protocol+\"//api.\"+h.slice(3):location.origin;const row=document.querySelector(\".model-row\"),form=document.querySelector(\".composer\"),message=document.getElementById(\"message\"),conversation=document.querySelector(\".conversation\");try{const r=await fetch(a+\"/v1/branding\");if(r.ok){const b=await r.json(),n=b.name||\"NolCore\";document.title=n+\" — Conversations\";document.querySelectorAll(\"a\").forEach(x=>{if(x.href.includes(\"noliae.com\"))x.href=b.search_url||b.website_url||x.href;else if(x.getAttribute(\"href\")===\"/compte\")x.href=b.account_url||x.href});document.querySelectorAll(\".breadcrumbs span:first-child\").forEach(x=>x.textContent=n)}}catch(_){}try{const r=await fetch(a+\"/v1/ia/models\",{credentials:\"include\"});if(r.ok){const models=await r.json();row.innerHTML=\"<span>MODÈLES</span>\"+models.map((m,i)=>\"<label><input type=radio name=model value='\"+m.provider+\"|\"+m.model+\"' \"+(i===0?\"checked\":\"\")+\"> \"+m.label+\"</label>\").join(\"\")}}catch(_){}form.addEventListener(\"submit\",async e=>{e.preventDefault();const pick=form.querySelector(\"input[name=model]:checked\");if(!pick||!message.value.trim())return;const text=message.value.trim(),[provider,model]=pick.value.split(\"|\");const button=form.querySelector(\"button[type=submit]\");button.disabled=true;try{const r=await fetch(a+\"/v1/ia/\"+encodeURIComponent(provider)+\"/\"+encodeURIComponent(model)+\"/\"+encodeURIComponent(text),{method:\"POST\",credentials:\"include\"});const out=await r.json();if(!r.ok)throw new Error(out.detail||\"Service IA indisponible.\");conversation.insertAdjacentHTML(\"beforeend\",\"<article class=user><small>Vous</small><p></p></article><article><small>Assistant <span></span></small><p></p></article>\");conversation.querySelector(\"article:nth-last-child(2) p\").textContent=text;conversation.querySelector(\"article:last-child span\").textContent=pick.parentElement.textContent.trim();conversation.querySelector(\"article:last-child p\").textContent=out.answer||out.text||out.content||JSON.stringify(out);message.value=\"\"}catch(err){alert(err.message||\"Service IA indisponible.\")}finally{button.disabled=false}})})();</script>\n</html>\n"
    return _o
}
