fn vue_chat(titre: Text, message: Text, answer: Text) -> Text {
    var _o = ""
    _o += "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#111111\">\n  <title>"
    _o += html_escape(titre)
    _o += " — Conversations</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link rel=\"stylesheet\" href=\"/static/noliae.css\">\n</head>\n<body>\n  <header class=\"appbar\">\n    <a class=\"brand\" href=\"/\"><span class=\"wave\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span> noliae <b>ia</b></a>\n    <div class=\"breadcrumbs\"><span>Noliae</span><i>/</i><strong>Conversations</strong></div>\n    <nav><a href=\"https://noliae.com\">Search</a><a href=\"/compte\">Compte</a><span class=\"avatar\">NL</span></nav>\n  </header>\n  <main>\n    <aside class=\"sidebar\">\n      <div class=\"workspace\"><span class=\"avatar large\">NL</span><div><strong>Mon espace</strong><small><i></i> Noliae personnel</small></div><b>⌄</b></div>\n      <p class=\"cap\">Espace IA</p>\n      <a class=\"active\" href=\"/\"><span>✦</span> Nouvelle discussion</a>\n      <a href=\"#conversations\"><span>◷</span> Conversations récentes</a>\n      <a href=\"#modeles\"><span>◇</span> Explorer les modèles</a>\n      <p class=\"cap lower\">Outils</p>\n      <a href=\"https://noliae.com\"><span>⌕</span> Recherche Noliae</a>\n      <a href=\"/parametres\"><span>⚙</span> Préférences</a>\n      <div class=\"sidebar-foot\"><p><i></i> Core connecté</p><span>Vos droits et votre session sont vérifiés par NolCore.</span></div>\n    </aside>\n    <section class=\"chat\" id=\"conversations\">\n      <div class=\"welcome\">\n        <p class=\"cap\"><i></i> Noliae IA <span>·</span> Conversation</p>\n        <h1>Une pensée,<br><em>plusieurs voix.</em></h1>\n        <p>Choisissez un modèle, posez une question et gardez votre travail relié à votre espace Noliae.</p>\n        <div class=\"prompts\"><button type=\"button\">Explique-moi un concept simplement</button><button type=\"button\">Aide-moi à structurer cette idée</button><button type=\"button\">Résume ce texte</button></div>\n      </div>\n      <div class=\"conversation\" aria-live=\"polite\">\n        "
    if message != "" {
    _o += "\n          <article class=\"user\"><small>Vous <span>Maintenant</span></small><p>"
    _o += html_escape(message)
    _o += "</p></article>\n          <article><small>Noliae IA <span>Modèle sélectionné</span></small><p>"
    _o += html_escape(answer)
    _o += "</p><footer><button type=\"button\">Copier</button><button type=\"button\">Recommencer</button></footer></article>\n        "
    }
    _o += "\n      </div>\n      <form class=\"composer\" action=\"/discussion\" method=\"post\">\n        <label class=\"sr-only\" for=\"message\">Votre message</label>\n        <textarea id=\"message\" name=\"message\" placeholder=\"Écrivez votre message…\" required></textarea>\n        <footer><select name=\"model\" aria-label=\"Modèle\"><option>ChatGPT · gpt-4o-mini</option><option>Mistral · Small</option><option>Claude · Sonnet</option><option>Gemini · Flash</option></select><span>Les réponses sont générées par IA</span><button>Envoyer <b>↑</b></button></footer>\n      </form>\n    </section>\n  </main>\n  <footer class=\"legal\">© Noliae · Les réponses peuvent contenir des erreurs. Vérifiez toujours les informations importantes. <span>IA / 01</span></footer>\n</body>\n</html>\n"
    return _o
}
