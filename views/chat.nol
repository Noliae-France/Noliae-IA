fn vue_chat(titre: Text, message: Text, answer: Text) -> Text {
    var _o = ""
    _o += "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#fafaf7\"><title>"
    _o += html_escape(titre)
    _o += "</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"/static/noliae.css\">\n  <style>\n    body{display:block;min-height:100vh;overflow:hidden}.app{min-height:100vh;display:grid;grid-template-columns:280px minmax(0,1fr);background:#fafaf7}.side{display:flex;flex-direction:column;padding:18px 12px;background:#fffdf9;border-right:1px solid #e5e4df}.ia-brand{display:flex;align-items:center;gap:10px;padding:5px 10px 23px;font:600 20px var(--mono);letter-spacing:-.09em}.ia-brand b{padding-left:10px;border-left:1px solid #dfded8;font:10px var(--mono);letter-spacing:.16em;color:var(--pulse)}.new{width:100%;padding:15px 16px;border:0;border-radius:7px;background:#171615;color:white;text-align:left;font:700 14px var(--sans);cursor:pointer}.new:hover{background:var(--pulse)}.cap{margin:30px 10px 8px;font:10px var(--mono);letter-spacing:.16em;text-transform:uppercase;color:#96948d}.side a{display:flex;align-items:center;gap:9px;padding:11px 10px;border-radius:6px;color:#3d3b37;text-decoration:none;font-size:14px}.side a:hover{background:#f0efeb}.side a.active{background:#171615;color:white}.side a i{font-style:normal;color:var(--pulse)}.side-foot{margin-top:auto;padding:17px 10px 3px;border-top:1px solid #e5e4df;color:#73716c;font-size:11px;line-height:1.65}.side-foot i{display:inline-block;width:7px;height:7px;margin-right:7px;border-radius:50%;background:var(--pulse)}.main{min-width:0;display:grid;grid-template-rows:64px minmax(0,1fr) auto}.top{display:flex;align-items:center;justify-content:space-between;padding:0 36px;border-bottom:1px solid #e5e4df;background:#fafaf7}.crumb{font:10px var(--mono);letter-spacing:.15em;color:#96948d}.crumb b{color:#171615}.top a{color:#171615;text-decoration:none;font-size:13px;font-weight:600}.stage{width:min(900px,100%);margin:auto;padding:38px clamp(26px,6vw,84px);overflow:auto}.welcome{min-height:100%;display:flex;flex-direction:column;justify-content:center}.eyebrow{margin:0;color:#77756f;font:10px var(--mono);letter-spacing:.15em;text-transform:uppercase}.eyebrow i{display:inline-block;width:7px;height:7px;margin-right:10px;border-radius:50%;background:var(--pulse)}h1{margin:20px 0 14px;font:500 clamp(52px,6.2vw,82px)/.91 var(--mono);letter-spacing:-.105em}h1 em{font-style:normal;color:var(--pulse)}.intro{max-width:570px;margin:0;color:#77756f;font-size:16px;line-height:1.65}.ideas{display:flex;flex-wrap:wrap;gap:9px;margin:28px 0}.ideas button{padding:10px 13px;border:1px solid #e3e2dd;border-radius:6px;background:#fff;color:#222;font:500 12px var(--sans);cursor:pointer}.ideas button:hover{border-color:#171615}.context{display:flex;gap:10px;margin-top:4px}.context article{width:210px;min-height:94px;padding:15px;border:1px solid #e3e2dd;background:#fff}.context small{display:block;color:#96948d;font:9px var(--mono);letter-spacing:.14em}.context b{display:block;margin-top:8px;font-size:14px}.context p{margin:5px 0 0;color:#77756f;font-size:11px;line-height:1.45}.history{margin-top:24px}.history article{padding:17px 0;border-top:1px solid #e5e4df;white-space:pre-wrap;line-height:1.65}.history .user{font-weight:700}.dock{padding:10px 38px 27px;background:linear-gradient(transparent,#fafaf7 30%)}.composer{max-width:900px;margin:auto;padding:9px;border:1px solid #171615;border-radius:7px;background:#fff;box-shadow:7px 7px 0 #ededea}.composer textarea{display:block;width:100%;min-height:86px;padding:8px;border:0;outline:0;resize:vertical;font:15px var(--sans)}.composer footer{display:flex;align-items:center;gap:12px;padding:9px 2px 1px;border-top:1px solid #e5e4df}.models{display:flex;gap:7px;max-width:58%;overflow:auto}.models button{padding:7px 10px;border:1px solid #e3e2dd;border-radius:99px;background:#fff;color:#292724;white-space:nowrap;font:11px var(--sans);cursor:pointer}.models button.on{border-color:#171615;background:#171615;color:#fff}.hint{margin-left:auto;color:#96948d;font-size:10px}.send{padding:10px 15px;border:0;border-radius:4px;background:#171615;color:#fff;font-weight:700;cursor:pointer}.send:hover{background:var(--pulse)}.notice{padding:8px 10px;color:#77756f;font-size:12px}.notice.error{color:#b32e1c}@media(max-width:720px){body{overflow:auto}.app{grid-template-columns:1fr}.side{display:none}.top{padding:0 20px}.stage{min-height:calc(100vh - 180px);padding:34px 22px}.dock{padding:10px 18px 18px;position:sticky;bottom:0}.context{display:none}.hint{display:none}.models{max-width:72%}h1{font-size:50px}}\n  </style>\n</head>\n<body>\n<div class=\"app\">\n  <aside class=\"side\"><div class=\"ia-brand\"><span data-brand>noliae</span><b>IA</b></div><button class=\"new\" type=\"button\" id=\"new-chat\">＋ Nouvelle discussion</button><p class=\"cap\">Conversations</p><a class=\"active\" href=\"#conversation\"><i>✦</i> Nouvelle discussion</a><a href=\"#conversation\">◌ Conversations récentes</a><p class=\"cap\">Outils</p><a data-app=\"search\" href=\"/\"><i>⌕</i> Recherche Noliae</a><a data-app=\"account\" href=\"/compte\"><i>⚙</i> Préférences</a><div class=\"side-foot\"><i></i>Core connecté<br><span>Votre session est vérifiée côté serveur.</span></div></aside>\n  <main class=\"main\"><header class=\"top\"><span class=\"crumb\">NOLIAE / <b>CONVERSATION</b></span><a data-app=\"account\" href=\"/compte\">Compte ↗</a></header><section class=\"stage\"><div class=\"welcome\"><p class=\"eyebrow\"><i></i>Noliae IA · conversation</p><h1>Une pensée,<br><em>plusieurs voix.</em></h1><p class=\"intro\">Choisissez un modèle, posez une question et gardez votre travail relié à votre espace Noliae.</p><div class=\"ideas\"><button type=\"button\">Explique-moi un concept simplement</button><button type=\"button\">Aide-moi à structurer cette idée</button><button type=\"button\">Résume ce texte</button></div><div class=\"context\"><article><small>INSTRUCTIONS</small><b>Définir le comportement</b><p>Personnalisez cet assistant</p></article><article><small>CONTEXTE</small><b>Ajouter des documents ＋</b><p>Vos fichiers restent dans Noliae</p></article></div><div id=\"conversation\" class=\"history\">"
    if message != "" {
    _o += "<article class=\"user\">"
    _o += html_escape(message)
    _o += "</article><article>"
    _o += html_escape(answer)
    _o += "</article>"
    }
    _o += "</div></div></section><div class=\"dock\"><form class=\"composer\" id=\"form\"><textarea id=\"message\" placeholder=\"Écrivez votre message…\" required></textarea><footer><div class=\"models\" id=\"models\"><button type=\"button\" disabled>Chargement des modèles…</button></div><span class=\"hint\">Les réponses peuvent contenir des erreurs.</span><button class=\"send\" type=\"submit\">Envoyer ↑</button></footer><p class=\"notice\" id=\"notice\" hidden></p></form></div></main>\n</div>\n<script src=\"/static/links.js\"></script>\n<script>\n(() => { const parts=location.hostname.split('.'), api=parts.length<3?location.origin:location.protocol+'//api.'+parts.slice(1).join('.'), models=document.getElementById('models'), input=document.getElementById('message'), notice=document.getElementById('notice'); let picked=null; const say=(text,error)=>{notice.hidden=!text;notice.textContent=text||'';notice.className='notice'+(error?' error':'')}; const json=async r=>{try{return await r.json()}catch(_){return {detail:'Réponse serveur invalide.'}}}; const list=raw=>Array.isArray(raw)?raw:(Array.isArray(raw.models)?raw.models:[]); fetch(api+'/v1/ia/models',{credentials:'include'}).then(async r=>{const data=await json(r);if(!r.ok)throw data;const entries=list(data);if(!entries.length)throw {detail:'Aucun modèle IA n’est configuré.'};models.innerHTML='';entries.forEach((entry,index)=>{const b=document.createElement('button');b.type='button';b.textContent=(entry.label||entry.provider)+' · '+entry.model;b.onclick=()=>{picked=entry;models.querySelectorAll('button').forEach(x=>x.classList.remove('on'));b.classList.add('on');say('')};models.appendChild(b);if(index===0)b.click()})}).catch(e=>{models.innerHTML='<button type=\"button\" disabled>Connexion requise</button>';say((e&&e.detail)||'Connectez-vous pour utiliser les modèles.',true)}); document.querySelectorAll('.ideas button').forEach(b=>b.onclick=()=>{input.value=b.textContent;input.focus()});document.getElementById('new-chat').onclick=()=>{document.getElementById('conversation').innerHTML='';input.value='';input.focus();history.replaceState(null,'',location.pathname)};document.getElementById('form').onsubmit=async e=>{e.preventDefault();const message=input.value.trim();if(!message)return;if(!picked){say('Choisissez un modèle après vous être connecté.',true);return}const history=document.getElementById('conversation'), user=document.createElement('article'), answer=document.createElement('article');user.className='user';user.textContent=message;answer.textContent='Réponse en cours…';history.append(user,answer);input.value='';say('');try{const response=await fetch(api+'/v1/ia',{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify({message:message,provider:picked.provider,model:picked.model})}),data=await json(response);if(!response.ok)throw data;answer.textContent=data.answer||data.result||'Aucune réponse reçue.'}catch(err){answer.textContent='';say((err&&err.detail)||'Le Core ne répond pas pour le moment.',true)}history.scrollIntoView({block:'end',behavior:'smooth'})}})();\n</script>\n</body></html>\n"
    return _o
}
