@model(titre: Text, message: Text, answer: Text)
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@titre</title><link rel="stylesheet" href="/static/noliae.css"><style>
body{display:block;height:100vh;overflow:hidden}.app{height:100vh;display:grid;grid-template-columns:258px 1fr;background:#fafaf7}.side{padding:18px 12px;background:#fffdf9;border-right:1px solid #e8e8e3;display:flex;flex-direction:column}.ia-brand{display:flex;gap:10px;align-items:center;padding:4px 8px 20px;font:600 18px var(--mono);letter-spacing:-.08em}.ia-brand b{font:10px var(--mono);letter-spacing:.14em;color:var(--pulse);border-left:1px solid #ddd;padding-left:10px}.new{width:100%;border:1px solid #e4e4df;background:#111;color:white;border-radius:6px;padding:12px;text-align:left;font-weight:600;cursor:pointer}.new:hover{background:var(--pulse)}.cap{font:10px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:#8a8a85;margin:22px 9px 7px}.side a{display:block;text-decoration:none;color:#2a2a2a;border-radius:5px;padding:10px;font-size:13px}.side a:hover{background:#f0f0ec}.side a.active{background:#111;color:#fff}.side a i{font-style:normal;color:var(--pulse);margin-right:8px}.side-foot{margin-top:auto;border-top:1px solid #e8e8e3;padding:15px 8px 3px;color:#777771;font-size:11px}.main{min-width:0;display:flex;flex-direction:column}.top{height:52px;border-bottom:1px solid #e8e8e3;display:flex;align-items:center;justify-content:space-between;padding:0 28px}.crumb{font:10px var(--mono);letter-spacing:.13em;color:#8a8a85}.crumb b{color:#111}.top a{color:#111;text-decoration:none;font-size:12px}.stage{width:min(830px,100%);margin:auto;padding:42px clamp(22px,7vw,82px) 14px;display:flex;flex:1;min-height:0}.welcome{margin:auto 0}.eyebrow{font:10px var(--mono);letter-spacing:.15em;text-transform:uppercase;color:#777771}.eyebrow i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--pulse);margin-right:10px}.welcome h1{margin:19px 0 14px;font:500 clamp(49px,6vw,76px)/.92 var(--mono);letter-spacing:-.1em}.welcome h1 em{font-style:normal;color:var(--pulse)}.welcome>p{max-width:530px;color:#777771;line-height:1.65}.ideas{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px}.ideas button{background:#fff;border:1px solid #e4e4df;border-radius:5px;padding:9px 11px;font-size:12px;cursor:pointer}.ideas button:hover{border-color:#111}.context{display:flex;gap:10px;margin-top:28px}.context article{width:190px;padding:14px;border:1px solid #e4e4df;background:#fff}.context small{display:block;color:#8a8a85;font:9px var(--mono);letter-spacing:.13em}.context b{display:block;margin-top:7px;font-size:13px}.context p{margin:5px 0 0;color:#777771;font-size:11px;line-height:1.4}.history{width:100%;margin-top:20px}.history article{padding:16px 0;border-top:1px solid #e8e8e3;line-height:1.6}.history .user{font-weight:600}.dock{padding:8px 38px 22px}.composer{max-width:830px;margin:auto;background:#fff;border:1px solid #111;border-radius:6px;padding:9px;box-shadow:6px 6px 0 #ededea}.composer textarea{width:100%;border:0;outline:0;resize:none;min-height:76px;padding:7px;font:15px var(--sans)}.composer footer{display:flex;gap:10px;align-items:center;border-top:1px solid #e8e8e3;padding-top:9px}.models{display:flex;gap:7px;overflow:auto}.models button{border:1px solid #e4e4df;background:#fff;border-radius:99px;padding:6px 10px;font-size:11px;white-space:nowrap;cursor:pointer}.models button.on{border-color:#111;background:#111;color:#fff}.hint{margin-left:auto;font-size:10px;color:#8a8a85}.send{background:#111;color:#fff;border:0;border-radius:3px;padding:9px 14px;font-weight:700;cursor:pointer}.send:hover{background:var(--pulse)}@@media(max-width:700px){.app{grid-template-columns:1fr}.side{display:none}.stage{padding-top:30px}.top{padding:0 18px}.dock{padding:8px 18px 18px}.welcome h1{font-size:50px}.context{display:none}.hint{display:none}}
</style></head><body><div class="app"><aside class="side"><div class="ia-brand"><span>noliae</span><b>IA</b></div><button class="new" type="button" onclick="resetChat()">＋ Nouvelle discussion</button><p class="cap">Conversations</p><a class="active" href="#"><i>✦</i>Nouvelle discussion</a><a href="#history">◌ Conversations récentes</a><p class="cap">Outils</p><a href="/">⌕ Recherche Noliae</a><a href="#">⚙ Préférences</a><div class="side-foot">● Core connecté<br><span>Votre session est vérifiée par NolCore.</span></div></aside><main class="main"><header class="top"><span class="crumb">NOLIAE / <b>CONVERSATION</b></span><a href="/compte">Compte ↗</a></header><section class="stage"><div class="welcome"><p class="eyebrow"><i></i>Noliae IA · conversation</p><h1>Une pensée,<br><em>plusieurs voix.</em></h1><p>Choisissez un modèle, posez une question et gardez votre travail relié à votre espace Noliae.</p><div class="ideas"><button>Explique-moi un concept simplement</button><button>Aide-moi à structurer cette idée</button><button>Résume ce texte</button></div><div class="context"><article><small>INSTRUCTIONS</small><b>Définir le comportement</b><p>Personnalisez cet assistant</p></article><article><small>CONTEXTE</small><b>Ajouter des documents ＋</b><p>Vos fichiers restent dans Noliae</p></article></div><div id="history" class="history">@if(message != "")<article class="user">@message</article><article>@answer</article>@endif</div></div></section><div class="dock"><form class="composer" id="form"><textarea id="message" placeholder="Votre message" required></textarea><footer><div class="models" id="models"><button type="button" disabled>Chargement des modèles…</button></div><span class="hint">Les réponses peuvent contenir des erreurs.</span><button class="send">Envoyer ↑</button></footer></form></div></main></div><script>(async()=>{const host=location.hostname,api=host.startsWith('ia.')?location.protocol+'//api.'+host.slice(3):location.origin,models=document.getElementById('models'),input=document.getElementById('message');let picked=null;try{const r=await fetch(api+'/v1/ia/models',{credentials:'include'});if(!r.ok)throw 0;const data=await r.json();models.innerHTML='';data.forEach((x,i)=>{const b=document.createElement('button');b.type='button';b.textContent=(x.label||x.provider)+' · '+x.model;b.onclick=()=>{picked=x;models.querySelectorAll('button').forEach(e=>e.classList.remove('on'));b.classList.add('on')};models.appendChild(b);if(!i)b.click()});if(!data.length)models.innerHTML='<button type="button" disabled>Aucun modèle disponible</button>'}catch(_){models.innerHTML='<button type="button" disabled>Connexion requise</button>'}document.querySelectorAll('.ideas button').forEach(b=>b.onclick=()=>{input.value=b.textContent;input.focus()});document.getElementById('form').onsubmit=async e=>{e.preventDefault();if(!picked||!input.value.trim())return;const q=input.value.trim(),h=document.getElementById('history');h.insertAdjacentHTML('beforeend','<article class="user"></article><article>Réponse en cours…</article>');h.lastElementChild.previousElementSibling.textContent=q;try{const r=await fetch(api+'/v1/ia',{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify({provider:picked.provider,model:picked.model,text:q})}),j=await r.json();h.lastElementChild.textContent=j.answer||j.result||j.detail||'Réponse indisponible.'}catch(_){h.lastElementChild.textContent='Connexion au Core impossible.'}input.value='';h.scrollIntoView({block:'end',behavior:'smooth'})}})();function resetChat(){location.href='/'}</script></body></html>
