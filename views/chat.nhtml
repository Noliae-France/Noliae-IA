@model(titre: Text, message: Text, answer: Text)
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#111111">
  <title>@titre — Conversations</title>
  <meta name="description" content="Noliae IA : un espace conversationnel multi-modèles relié au Core Noliae.">
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
  <link rel="canonical" href="https://ia.noliae.com/">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="Noliae IA">
  <meta property="og:title" content="Noliae IA — Une pensée, plusieurs voix">
  <meta property="og:description" content="Un espace conversationnel multi-modèles relié au Core Noliae.">
  <meta property="og:url" content="https://ia.noliae.com/">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Noliae IA — Une pensée, plusieurs voix">
  <meta name="twitter:description" content="Un espace conversationnel multi-modèles relié au Core Noliae.">
  <script type="application/ld+json">{"@@context":"https://schema.org","@@type":"WebApplication","name":"Noliae IA","url":"https://ia.noliae.com/","applicationCategory":"BusinessApplication","operatingSystem":"Web"}</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/static/noliae.css">
  <style>.agent-setup{display:flex;align-items:center;gap:14px;margin:28px 0 20px}.agent-symbol{color:#FF4D2E;font:26px ui-monospace,monospace;letter-spacing:-8px;width:44px}.setup-cards{display:flex;gap:9px;flex:1}.setup-cards button{background:#fff;color:#111;border:1px solid #E4E4DF;padding:12px;text-align:left;min-width:190px}.setup-cards small{display:block;font:9px ui-monospace,monospace;letter-spacing:.11em;color:#777}.setup-cards strong{display:block;font-size:12px;margin:5px 0}.setup-cards span{font-size:10px;color:#777}.composer-tools{display:flex;align-items:center;gap:8px;padding:3px 4px 8px}.composer-tools button{background:transparent!important;color:#777!important;border:0;padding:3px;font:15px ui-monospace,monospace}.composer-tools span{font-size:10px;color:#777}.model-row{display:flex;align-items:center;gap:6px;overflow:auto;padding:7px 2px;border-top:1px solid #E4E4DF}.model-row>span{font:9px ui-monospace,monospace;letter-spacing:.1em;color:#777}.model-row label{white-space:nowrap;border:1px solid #E4E4DF;border-radius:99px;padding:4px 8px;font-size:10px;cursor:pointer}.model-row input{accent-color:#FF4D2E;width:10px;height:10px}.composer footer{border-top:0!important;padding-top:1px!important}</style>
</head>
<body>
  <header class="appbar">
    <a class="brand" href="/"><span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span> noliae <b>ia</b></a>
    <div class="breadcrumbs"><span>Noliae</span><i>/</i><strong>Conversations</strong></div>
    <nav><a href="https://noliae.com">Search</a><a href="/compte">Compte</a><span class="avatar">NL</span></nav>
  </header>
  <main>
    <aside class="sidebar">
      <div class="workspace"><span class="avatar large">NL</span><div><strong>Mon espace</strong><small><i></i> Noliae personnel</small></div><b>⌄</b></div>
      <p class="cap">Espace IA</p>
      <a class="active" href="/"><span>✦</span> Nouvelle discussion</a>
      <a href="#conversations"><span>◷</span> Conversations récentes</a>
      <a href="#modeles"><span>◇</span> Explorer les modèles</a>
      <p class="cap lower">Outils</p>
      <a href="https://noliae.com"><span>⌕</span> Recherche Noliae</a>
      <a href="/parametres"><span>⚙</span> Préférences</a>
      <div class="sidebar-foot"><p><i></i> Core connecté</p><span>Vos droits et votre session sont vérifiés par NolCore.</span></div>
    </aside>
    <section class="chat" id="conversations">
      <div class="welcome">
        <p class="cap"><i></i> Noliae IA <span>·</span> Conversation</p>
        <h1>Une pensée,<br><em>plusieurs voix.</em></h1>
        <p>Choisissez un modèle, posez une question et gardez votre travail relié à votre espace Noliae.</p>
        <div class="prompts"><button type="button">Explique-moi un concept simplement</button><button type="button">Aide-moi à structurer cette idée</button><button type="button">Résume ce texte</button></div>
        <section class="agent-setup" id="modeles">
          <div class="agent-symbol">▂<b>█</b>▂</div>
          <div class="setup-cards"><button type="button"><small>INSTRUCTIONS</small><strong>Définir le comportement</strong><span>Personnalisez cet assistant</span></button><button type="button"><small>CONTEXTE</small><strong>Ajouter des documents <b>＋</b></strong><span>Vos fichiers restent dans Noliae</span></button></div>
        </section>
      </div>
      <div class="conversation" aria-live="polite">
        @if(message != "")
          <article class="user"><small>Vous <span>Maintenant</span></small><p>@message</p></article>
          <article><small>Noliae IA <span>Modèle sélectionné</span></small><p>@answer</p><footer><button type="button">Copier</button><button type="button">Recommencer</button></footer></article>
        @endif
      </div>
      <form class="composer" action="/discussion" method="post">
        <label class="sr-only" for="message">Votre message</label>
        <textarea id="message" name="message" placeholder="Écrivez votre message…" required></textarea>
        <div class="composer-tools"><button type="button" aria-label="Joindre un fichier">⌕</button><button type="button" aria-label="Image">▧</button><span>Ajoutez un contexte ou une pièce jointe</span></div>
        <div class="model-row" aria-label="Modèles disponibles"><span>MODÈLES</span><label><input type="radio" name="model" value="chatgpt|gpt-4o-mini" checked> ChatGPT</label><label><input type="radio" name="model" value="claude|claude-3-5-sonnet-latest"> Claude</label><label><input type="radio" name="model" value="mistral|mistral-small-latest"> Mistral</label><label><input type="radio" name="model" value="gemini|gemini-1.5-flash"> Gemini</label></div>
        <footer><span>Les réponses sont générées par IA · accès contrôlé par NolCore</span><button>Envoyer <b>↑</b></button></footer>
      </form>
    </section>
  </main>
  <footer class="legal">© Noliae · Les réponses peuvent contenir des erreurs. Vérifiez toujours les informations importantes. <span>IA / 01</span></footer>
</body>
</html>
