@model(titre: Text, message: Text, answer: Text)
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#fafaf7">
  <meta name="color-scheme" content="light">
  <title>@titre</title>
  <link rel="stylesheet" href="/static/bulma.min.css"><link rel="stylesheet" href="/static/noliae.css">
  <style>
    :root{--ash:#8A8A85;--paper-2:#fff;--bubble:#F4F4F0;--sidebg:#F4F4F0;--t:.18s;--ease:cubic-bezier(.6,.05,.25,1);--side-w:262px}
    *,*::before,*::after{box-sizing:border-box}
    html,body,input,textarea,select,button{color-scheme:light}
    html,body{height:100%;margin:0}
    body{font-family:var(--sans);background:var(--paper);color:var(--ink);font-size:15px;overflow:hidden}
    button{background:none;border:0;padding:0;margin:0;cursor:pointer;color:inherit;font:inherit}
    .app{display:grid;grid-template-columns:var(--side-w) 1fr;height:100vh;transition:grid-template-columns var(--t) var(--ease)}
    .app.collapsed{grid-template-columns:0 1fr}
    .side{background:var(--sidebg);border-right:1px solid var(--line);display:flex;flex-direction:column;overflow:hidden;min-width:0}
    .side .sh{display:flex;align-items:center;justify-content:space-between;padding:14px 14px 10px}
    .side .brand{display:flex;align-items:center;gap:9px;font-family:var(--mono);font-weight:500;font-size:15px;letter-spacing:-.05em;color:var(--ink);text-decoration:none}
    .side .brand .wave{gap:2px}
    .side .brand .wave i{width:3px;background:var(--ink);border-radius:4px}
    .side .brand .wave i:nth-child(1),.side .brand .wave i:nth-child(7){height:7px}
    .side .brand .wave i:nth-child(2),.side .brand .wave i:nth-child(6){height:12px}
    .side .brand .wave i:nth-child(3),.side .brand .wave i:nth-child(5){height:16px}
    .side .brand .wave i:nth-child(4){height:20px;background:var(--pulse)}
    .side .slash{font-family:var(--mono);font-size:8px;letter-spacing:.16em;text-transform:uppercase;color:var(--pulse);padding:3px 6px;border:1px solid rgba(255,77,46,.4);border-radius:100px}
    .newc{display:flex;align-items:center;gap:9px;margin:2px 12px 12px;padding:10px 12px;border:1px solid var(--line);background:var(--paper-2);border-radius:10px;font-size:13.5px;font-weight:500;transition:border-color var(--t),box-shadow var(--t)}
    .newc:hover{border-color:var(--ash);box-shadow:0 1px 4px rgba(0,0,0,.04)}
    .newc svg{width:16px;height:16px;display:block}
    .convs{flex:1;overflow-y:auto;padding:2px 8px 12px}
    .convs .dh{font-family:var(--mono);font-size:8.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--ash);padding:12px 8px 6px}
    .conv{display:flex;align-items:center;gap:8px;padding:9px 10px;border-radius:8px;cursor:pointer;color:var(--muted);font-size:13.5px;transition:background var(--t),color var(--t);position:relative}
    .conv .logo{width:15px;height:15px;flex-shrink:0}
    .conv:hover{background:rgba(0,0,0,.045);color:var(--ink)}
    .conv.on{background:var(--paper-2);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.05)}
    .conv .tt{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .conv .del{opacity:0;width:22px;height:22px;border-radius:6px;display:grid;place-items:center;color:var(--ash);flex-shrink:0;transition:opacity var(--t),background var(--t),color var(--t)}
    .conv:hover .del{opacity:1}
    .conv .del:hover{background:#FFE9E2;color:var(--pulse)}
    .conv .del svg{width:13px;height:13px}
    .side .sf{padding:12px;border-top:1px solid var(--line);display:flex;align-items:center;gap:10px}
    .side .sf a{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit;flex:1;min-width:0}
    .side .sf .av{width:28px;height:28px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-family:var(--mono);font-size:11px;font-weight:500;flex-shrink:0}
    .side .sf .nm{font-size:12.5px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .side .sf .rl{font-size:11px;color:var(--ash);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .main{display:flex;flex-direction:column;min-width:0;overflow:hidden}
    .top{height:52px;display:flex;align-items:center;gap:12px;padding:0 16px;flex-shrink:0}
    .iconbtn{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;color:var(--muted);transition:background var(--t)}
    .iconbtn:hover{background:var(--bubble)}
    .iconbtn svg{width:18px;height:18px;display:block}
    .cur-model{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:500;color:var(--muted)}
    .top{position:relative}
    .share-btn{margin-left:auto;display:flex;align-items:center;gap:7px;padding:7px 13px;border:1px solid var(--line);border-radius:100px;font-size:12.5px;font-weight:500;color:var(--muted);transition:border-color var(--t),color var(--t),background var(--t)}
    .share-btn:hover{border-color:var(--ash);color:var(--ink);background:var(--bubble)}
    .share-btn.on{border-color:var(--pulse);color:var(--pulse);background:#FFF4F1}
    .share-btn svg{width:14px;height:14px}
    .share-pop{position:absolute;top:48px;right:16px;z-index:50;width:300px;background:var(--paper-2);border:1px solid var(--line);border-radius:14px;box-shadow:0 12px 30px rgba(0,0,0,.12);padding:14px}
    .share-pop h4{margin:0 0 4px;font-size:13.5px;font-weight:600}
    .share-pop p{margin:0 0 10px;font-size:12px;color:var(--ash);line-height:1.5}
    .share-pop .row{display:flex;gap:6px}
    .share-pop input{flex:1;height:34px;border:1px solid var(--line);border-radius:8px;padding:0 10px;font-size:11.5px;font-family:var(--mono);background:var(--paper);color:var(--muted)}
    .share-pop button{height:34px;padding:0 12px;border-radius:8px;background:var(--ink);color:#fff;font-size:12px;font-weight:600;flex-shrink:0}
    .share-pop button:hover{background:var(--pulse)}
    .share-pop .unshare{margin-top:9px;background:none;color:var(--pulse);font-size:11.5px;font-weight:500;padding:0;height:auto}
    .cur-model .logo{width:17px;height:17px}
    .logo{width:19px;height:19px;flex-shrink:0;display:block;border-radius:5px}
    .composer-toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:2px}
    .tools-left{display:flex;align-items:center;gap:6px;flex-wrap:wrap;min-width:0}
    .providers{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
    .providers .prov{display:flex;align-items:center;gap:4px;height:22px;padding:0 8px;border:1px solid var(--line);border-radius:100px;font-size:10.5px;font-weight:500;background:var(--paper);color:#57534e;transition:border-color var(--t),color var(--t),background var(--t)}
    .providers .prov:hover{border-color:var(--ash);color:var(--ink)}
    .providers .prov.on{border-color:var(--pulse);color:var(--ink);background:#FFF4F1}
    .providers .prov .logo{width:13px;height:13px}
    .providers .prov .cv{width:11px;height:11px;color:var(--ash)}
    .ia-modal-veil{position:fixed;inset:0;background:rgba(17,17,17,.4);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;z-index:100;padding:24px}
    .ia-modal{width:100%;max-width:420px;max-height:80vh;background:var(--paper-2);border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.25);display:flex;flex-direction:column;overflow:hidden}
    .ia-modal header{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid var(--line);flex-shrink:0}
    .ia-modal header h2{font-size:15px;font-weight:600;margin:0}
    .modal-list{overflow-y:auto;padding:8px}
    .modal-group{padding:10px 10px 4px;font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ash)}
    .modal-opt{display:flex;align-items:center;gap:11px;padding:10px;border-radius:10px;cursor:pointer;transition:background var(--t)}
    .modal-opt:hover{background:var(--bubble)}
    .modal-opt .logo{width:24px;height:24px}
    .modal-opt .tx{flex:1;min-width:0}
    .modal-opt .nm{font-size:13.5px;font-weight:500;color:var(--ink)}
    .modal-opt .ds{font-size:11.5px;color:var(--ash);margin-top:1px}
    .modal-opt .ck{width:16px;height:16px;color:var(--ink);opacity:0;flex-shrink:0}
    .modal-opt.on .ck{opacity:1}
    .scroll{flex:1;overflow-y:auto}
    .stage{width:100%;max-width:920px;margin:0 auto;padding:0 24px;min-height:100%;display:flex;flex-direction:column}
    .empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding-bottom:8vh}
    .empty .mark{filter:drop-shadow(0 4px 10px rgba(0,0,0,.08))}
    .empty .mark .wave{gap:4px;align-items:center}
    .empty .mark .wave i{width:8px;background:var(--ink);border-radius:5px;transform-origin:center;animation:eq .9s ease-in-out infinite}
    .empty .mark .wave i:nth-child(1),.empty .mark .wave i:nth-child(7){height:24px;animation-delay:-.6s}
    .empty .mark .wave i:nth-child(2),.empty .mark .wave i:nth-child(6){height:40px;animation-delay:-.3s}
    .empty .mark .wave i:nth-child(3),.empty .mark .wave i:nth-child(5){height:56px;animation-delay:-.75s}
    .empty .mark .wave i:nth-child(4){height:70px;background:var(--pulse);animation-delay:-.15s}
    @@keyframes eq{0%,100%{transform:scaleY(.45)}50%{transform:scaleY(1)}}
    @@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
    .empty .h{font-size:22px;font-weight:500;letter-spacing:-.02em}
    .empty .sub{font-size:14px;color:var(--ash);margin-top:-8px}
    .sugg{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;max-width:520px;margin-top:6px}
    .sugg button{font-size:12.5px;color:var(--muted);padding:8px 13px;border:1px solid var(--line);border-radius:100px;background:var(--paper-2);transition:border-color var(--t),color var(--t),transform var(--t)}
    .sugg button:hover{border-color:var(--ash);color:var(--ink);transform:translateY(-1px)}
    .thread{padding:22px 0 20px;display:flex;flex-direction:column;gap:22px}
    .msg{display:flex;gap:12px}
    .msg.u{flex-direction:row-reverse;justify-content:flex-start}
    .msg .ava{width:26px;height:26px;border-radius:7px;flex-shrink:0;display:grid;place-items:center;overflow:hidden}
    .msg.u .ava{background:var(--ink);color:#fff;font-family:var(--mono);font-size:10px;font-weight:500;border-radius:50%}
    .msg.u .body{flex:0 1 auto;max-width:72%;background:var(--bubble);border-radius:16px 16px 4px 16px;padding:10px 14px;color:var(--ink)}
    .msg.u .body p{margin:0 0 6px}.msg.u .body p:last-child{margin:0}
    .msg .ava .logo{width:26px;height:26px;border-radius:7px}
    .msg .body{padding-top:2px;line-height:1.62;flex:1;min-width:0;color:var(--carbon)}
    .msg .body,.msg .body *{color:var(--carbon)!important;text-decoration:none!important}
    .msg .body :not(pre):not(code):not(.dots i):not(.who){background:none!important}
    .msg .body code{background:var(--bubble)!important}
    .msg .body .dots i{background:var(--ash)!important}
    .msg.u .body,.msg.u .body *{color:var(--ink)!important}
    .msg .body p{margin:0 0 10px}.msg .body p:last-child{margin:0}
    .msg .body ul,.msg .body ol{margin:0 0 10px;padding-left:20px}
    .msg .body li{margin:3px 0}
    .msg .body code{font-family:var(--mono);font-size:.86em;background:var(--bubble);padding:1px 5px;border-radius:4px}
    .msg .body pre{position:relative;background:#1E1E1C!important;border:1px solid var(--line);border-radius:8px;padding:14px 14px 12px;overflow-x:auto;margin:0 0 10px}
    .msg .body pre code{background:none!important;padding:0;font-size:12.5px;line-height:1.6;color:#E8E6E1!important}
    .msg .body .code-lang{position:absolute;top:0;right:0;padding:3px 10px;font:10px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:#9A968D!important;background:rgba(255,255,255,.08)!important;border-radius:0 8px 0 8px}
    .msg .body .tok-kw{color:#FF8B6B!important;font-weight:500}
    .msg .body .tok-str{color:#9FD68C!important}
    .msg .body .tok-cm{color:#8A8680!important;font-style:italic}
    .msg .body .tok-num{color:#8EC9E8!important}
    .msg .body strong{font-weight:600}
    .msg .who{font-size:11px;color:var(--ash);font-weight:500;margin-bottom:3px}
    .dots{display:inline-flex;gap:4px;padding-top:6px}
    .dots i{width:6px;height:6px;border-radius:50%;background:var(--ash);animation:bl 1.2s infinite}
    .dots i:nth-child(2){animation-delay:.2s}.dots i:nth-child(3){animation-delay:.4s}
    @@keyframes bl{0%,60%,100%{opacity:.25}30%{opacity:1}}
    .dock{flex-shrink:0;padding:4px 20px 10px;background:linear-gradient(to top,var(--paper) 66%,transparent)}
    .composer{width:100%;max-width:920px;margin:0 auto}
    .composer-card{background:var(--paper-2);border:1px solid var(--line);border-radius:18px;padding:6px 10px 5px;box-shadow:0 1px 3px rgba(0,0,0,.04);transition:border-color var(--t),box-shadow var(--t)}
    .composer-card:focus-within{border-color:var(--ash);box-shadow:0 6px 20px rgba(0,0,0,.07)}
    .tools-left .ic{width:22px;height:22px;padding:0;border-radius:50%;display:grid;place-items:center;color:var(--ash);flex-shrink:0;transition:background var(--t),color var(--t)}
    .tools-left .ic:hover{background:var(--bubble);color:var(--muted)}
    .tools-left .ic svg{width:13px;height:13px;display:block}
    textarea{width:100%;display:block;resize:none;border:0;outline:0;background:none;font-size:14px;font-family:var(--sans);line-height:1.25;padding:0 2px;max-height:100px;color:var(--ink);color-scheme:light;-webkit-text-fill-color:var(--ink)}
    textarea::placeholder{color:var(--ash)}
    .composer-toolbar .send{width:24px;height:24px;padding:0;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;flex-shrink:0;transition:opacity var(--t),transform var(--t),background var(--t)}
    .send:not(:disabled):hover{background:var(--pulse)}
    .send:disabled{background:var(--line);color:var(--ash);cursor:default}
    .send:not(:disabled):hover{transform:scale(1.05)}
    .send svg{width:16px;height:16px;display:block}
    .foot{text-align:center;font-size:10.5px;color:var(--ash);margin-top:6px}
    .share-cta{display:flex;align-items:center;justify-content:center;gap:14px;padding:12px 18px;border:1px solid var(--line);border-radius:14px;background:var(--paper-2);font-size:12.5px;color:var(--muted)}
    .share-cta a{color:var(--pulse);font-weight:600;text-decoration:none;white-space:nowrap}
    .notice{color:var(--pulse)}
    @@media(max-width:760px){.app{grid-template-columns:0 1fr}.side{border-right:0}}
  </style>
</head>
<body>
<div class="app" id="app">
  <aside class="side">
    <div class="sh">
      <a class="brand" data-app="search" href="/"><span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span><span data-brand>noliae</span><span class="slash">AI</span></a>
    </div>
    <button class="newc" type="button" id="newChat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 5v14M5 12h14"></path></svg>Nouvelle discussion</button>
    <div class="convs" id="convs"></div>
    <div class="sf"><a data-app="account" href="/compte"><span class="av" id="side-av">·</span><div><div class="nm" id="side-name">…</div><div class="rl" id="side-email"></div></div></a></div>
  </aside>

  <div class="main">
    <div class="top">
      <button class="iconbtn" id="toggle" title="Masquer l'historique"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M9 4v16"></path></svg></button>
      <div class="cur-model" id="curModelBadge"></div>
      <button type="button" class="share-btn" id="shareBtn" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a3 3 0 1 0-2.83-4H15a3 3 0 0 0 .05 2.9L8.9 10.2a3 3 0 1 0 0 3.6l6.15 3.3A3 3 0 1 0 18 16a2.98 2.98 0 0 0-.24 1.06l-6.2-3.33a3 3 0 0 0 0-1.46l6.2-3.33A3 3 0 0 0 18 8Z"></path></svg><span>Partager</span></button>
      <div class="share-pop" id="sharePop" hidden>
        <h4>Lien de partage public</h4>
        <p>Toute personne avec ce lien peut lire cette conversation, sans se connecter.</p>
        <div class="row"><input type="text" id="shareUrl" readonly><button type="button" id="shareCopy">Copier</button></div>
        <button type="button" class="unshare" id="shareOff">Arrêter le partage</button>
      </div>
    </div>

    <div class="scroll" id="scroll">
      <div class="stage">
        <div class="empty" id="empty">
          <div class="mark"><span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span></div>
          <div class="h">Comment puis-je vous aider ?</div>
          <div class="sub">Choisissez un modèle et posez votre question.</div>
          <div class="sugg" id="sugg">
            <button type="button">Rédige un e-mail de relance client</button>
            <button type="button">Explique le WAF en une phrase</button>
            <button type="button">Idées de nom pour un SaaS</button>
            <button type="button">Corrige ce texte en français</button>
          </div>
        </div>
        <div class="thread" id="thread" style="display:none"></div>
      </div>
    </div>

    <div class="dock">
      <div class="composer">
        <div class="composer-card">
          <textarea id="ta" rows="1" placeholder="Écrivez votre question…" disabled></textarea>
          <div class="composer-toolbar">
            <div class="tools-left">
              <button class="ic" id="attach" title="Joindre un document" type="button" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.5 12.5 21a5 5 0 0 1-7-7l8.5-8.5a3.5 3.5 0 0 1 5 5L10.5 19a2 2 0 0 1-3-3l8-8"></path></svg></button>
              <input type="file" id="attachInput" accept=".txt,.md,.csv,.json,.log,text/plain" hidden>
              <div class="providers" id="providers"></div>
            </div>
            <button class="send" id="send" disabled type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 20V5M6 11l6-6 6 6"></path></svg></button>
          </div>
        </div>
        <div class="foot" id="foot">Noliae AI peut se tromper · vérifiez les informations importantes.</div>
      </div>
    </div>
  </div>
</div>
<div class="ia-modal-veil" id="modelModalVeil" hidden>
  <div class="ia-modal" role="dialog" aria-modal="true" aria-label="Choisir un modèle">
    <header><h2>Choisir un modèle</h2><button type="button" class="iconbtn" id="modelModalClose"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6l12 12M18 6 6 18"/></svg></button></header>
    <div class="modal-list" id="modelModalList"></div>
  </div>
</div>
<script src="/static/links.js"></script>
<script>
(()=>{
const p=location.hostname.split('.'),api=p.length<3?location.origin:location.protocol+'//api.'+p.slice(1).join('.'),
login=p.length<3?'/':location.protocol+'//login.'+p.slice(1).join('.'),
goLogin=()=>location.replace(login+'/?return_to='+encodeURIComponent(location.href));

const LOGOS={
  chatgpt:'<svg class="logo" viewBox="0 0 24 24"><rect width="24" height="24" rx="5" fill="#fff" stroke="#E8E8E3"/><path fill="#0B0B0B" d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.8956zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.4592a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654 2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z"/></svg>',
  claude:'<svg class="logo" viewBox="0 0 40 40"><rect width="40" height="40" rx="9" fill="#D97757"/><path fill="#fff" d="M12.4 26.5 17 14.2c.2-.5.6-.7 1.1-.7s.9.3 1.1.7l4.6 12.3c.2.6-.1 1.1-.6 1.3-.6.2-1.1-.1-1.3-.6l-1-2.8h-5.1l-1 2.8c-.2.5-.7.8-1.3.6-.5-.2-.8-.7-.6-1.3Z"/></svg>',
  mistral:'<svg class="logo" viewBox="0 0 40 40"><rect width="40" height="40" rx="9" fill="#0B0B0B"/><g transform="translate(8 11)"><rect x="0" y="0" width="4.6" height="4.6" fill="#FFD800"/><rect x="19.4" y="0" width="4.6" height="4.6" fill="#FFD800"/><rect x="0" y="4.6" width="4.6" height="4.6" fill="#FFAF00"/><rect x="4.8" y="4.6" width="4.6" height="4.6" fill="#FFAF00"/><rect x="14.6" y="4.6" width="4.6" height="4.6" fill="#FFAF00"/><rect x="19.4" y="4.6" width="4.6" height="4.6" fill="#FFAF00"/><rect x="0" y="9.2" width="24" height="4.6" fill="#FF8205"/><rect x="0" y="13.8" width="4.6" height="4.6" fill="#FA500F"/><rect x="9.7" y="13.8" width="4.6" height="4.6" fill="#FA500F"/><rect x="19.4" y="13.8" width="4.6" height="4.6" fill="#FA500F"/></g></svg>',
  gemini:'<svg class="logo" viewBox="0 0 40 40"><defs><linearGradient id="gg" x1="0" y1="0" x2="40" y2="40"><stop offset="0" stop-color="#4E8CF5"/><stop offset="1" stop-color="#8E5CF6"/></linearGradient></defs><rect width="40" height="40" rx="9" fill="#0B0B0B"/><path fill="url(#gg)" d="M20 8c.3 5.5 4.7 9.9 12 12-7.3 2.1-11.7 6.5-12 12-.3-5.5-4.7-9.9-12-12 7.3-2.1 11.7-6.5 12-12Z"/></svg>',
  grok:'<svg class="logo" viewBox="0 0 40 40"><rect width="40" height="40" rx="9" fill="#000"/><path fill="#fff" d="M11 28 22 12h4L15 28h-4Zm6 0 8-11.5V28h-3V21l-3 4.3z"/></svg>',
  deepseek:'<svg class="logo" viewBox="0 0 40 40"><rect width="40" height="40" rx="9" fill="#4D6BFE"/><circle cx="20" cy="20" r="9" fill="#fff"/><circle cx="23" cy="17" r="2.6" fill="#4D6BFE"/></svg>'
};
const DEFAULT_LOGO='<svg class="logo" viewBox="0 0 40 40"><rect width="40" height="40" rx="9" fill="#111"/><path fill="#FF4D2E" d="M12 20c.2-4 3.4-7.2 8-7.4-2.6 1.5-4.2 4.3-4.3 7.4.1 3.1 1.7 5.9 4.3 7.4-4.6-.2-7.8-3.4-8-7.4Z"/></svg>';
const logoFor=provider=>LOGOS[provider]||DEFAULT_LOGO;

// Lien de partage public (/chat/<uuid>?public=1) : lecture seule, AUCUNE
// authentification requise. Court-circuite tout le reste du bootstrap
// (sidebar/composer/modèles), qui n'a pas de sens pour un visiteur anonyme.
if(new URLSearchParams(location.search).get('public')==='1'){
  const m=/^\/chat\/([^/]+)$/.exec(location.pathname);
  document.getElementById('app').classList.add('collapsed');
  document.getElementById('empty').style.display='none';
  const thread=document.getElementById('thread'),scroll=document.getElementById('scroll');
  thread.style.display='';
  document.querySelector('.dock').innerHTML='<div class="composer"><div class="share-cta"><span>Vous consultez une conversation partagée en lecture seule.</span><a href="'+login+'/?return_to='+encodeURIComponent(location.origin)+'">Essayer Noliae IA →</a></div></div>';
  if(m){
    fetch(api+'/v1/conversations/'+encodeURIComponent(m[1])+'/public').then(async r=>{
      if(!r.ok)throw 0; return r.json();
    }).then(data=>{
      document.getElementById('curModelBadge').innerHTML=logoFor(data.provider)+'<span>'+esc(data.model||data.provider)+'</span>';
      (data.messages||[]).forEach(msg=>renderMsg(msg.role,msg.role==='user'?esc(msg.content).replace(/\n/g,'<br>'):md(msg.content),data.provider,data.model));
      scroll.scrollTop=0;
    }).catch(()=>{thread.innerHTML='<p style="padding:24px;color:var(--ash)">Cette conversation n\'est plus partagée, ou n\'existe pas.</p>'});
  }
  return;
}

let MODELS=[],curModel=null,PROVIDERS=[];
// Ordre de préférence par coût (les moins chers en tête) : le premier
// fournisseur DISPONIBLE de cette liste devient le choix par défaut.
const ORDRE_ECONOMIQUE=['mistral','gemini','chatgpt','claude'];
const MODEL_KEY='noliae_ai_model_v1';
function setCurModel(m){curModel=m;if(m){try{localStorage.setItem(MODEL_KEY,JSON.stringify({provider:m.provider,model:m.model}))}catch(_){}}}

// L'historique vit en base (table conversations/messages, déjà écrite par
// /v1/ia à chaque message) : cette liste n'est qu'un cache d'affichage de
// /v1/conversations, jamais la source de vérité.
let chats=[],activeId=null,busy=false;
const CONVS_KEY='noliae_ai_convs_v1';
// Rejoue l'historique en cache instantanément (avant même la requête réseau)
// pour éviter le clignotement « vide puis repeuplé » au refresh.
try{const cached=JSON.parse(localStorage.getItem(CONVS_KEY)||'null');if(Array.isArray(cached)){chats=cached;renderConvs()}}catch(_){}
async function loadConvs(){
  try{
    const r=await fetch(api+'/v1/conversations',{credentials:'include'});
    if(r.ok){chats=await r.json();try{localStorage.setItem(CONVS_KEY,JSON.stringify(chats))}catch(_){}}
  }catch(_){}
  renderConvs();
}

const providersEl=document.getElementById('providers');
// Une entrée par FOURNISSEUR (pas par modèle : la liste complète peut
// compter des dizaines de variantes) — le premier modèle de chaque
// fournisseur est déjà son choix « courant » (voir ia_modele_prioritaire
// côté serveur), donc directement utilisable ici.
function calculerProviders(){
  const vus=new Set();
  PROVIDERS=MODELS.filter(m=>{if(vus.has(m.provider))return false;vus.add(m.provider);return true});
}
// Une pastille par fournisseur (façon Mammouth) : clic = bascule directe sur
// ce fournisseur ; re-cliquer sur celui déjà actif ouvre le choix du modèle
// précis (variantes) quand il y en a plusieurs.
function renderProviders(){
  providersEl.innerHTML=PROVIDERS.map(p=>'<button type="button" class="prov'+(curModel&&curModel.provider===p.provider?' on':'')+'" data-provider="'+esc(p.provider)+'">'+logoFor(p.provider)+'<span>'+esc(p.label||p.provider)+'</span></button>').join('');
  providersEl.querySelectorAll('.prov').forEach(btn=>btn.addEventListener('click',()=>{
    const p=btn.dataset.provider;
    if(curModel&&curModel.provider===p){openModelModal(p);return}
    setCurModel(PROVIDERS.find(m=>m.provider===p)||curModel);
    renderProviders();
  }));
  const badge=document.getElementById('curModelBadge');
  if(curModel)badge.innerHTML=logoFor(curModel.provider)+'<span>'+esc(curModel.model||curModel.label||curModel.provider)+'</span>';
}

const modelVeil=document.getElementById('modelModalVeil'),modelList=document.getElementById('modelModalList');
function openModelModal(focusProvider){
  // Depuis une pastille précise, on ne montre QUE les modèles de ce
  // fournisseur (choisir ChatGPT ne doit jamais faire apparaître Mistral) ;
  // sans fournisseur ciblé, tous les fournisseurs restent groupés.
  const source=focusProvider?MODELS.filter(m=>m.provider===focusProvider):MODELS;
  const groupes={};
  source.forEach(m=>{(groupes[m.provider]=groupes[m.provider]||[]).push(m)});
  const titre=document.querySelector('.ia-modal header h2');
  titre.textContent=focusProvider?('Choisir un modèle · '+(groupes[focusProvider]&&(groupes[focusProvider][0].label||focusProvider))):'Choisir un modèle';
  modelList.innerHTML=Object.keys(groupes).map(p=>(focusProvider?'':'<div class="modal-group">'+esc(groupes[p][0].label||p)+'</div>')+groupes[p].map(m=>'<div class="modal-opt '+(m===curModel?'on':'')+'" data-provider="'+esc(m.provider)+'" data-model="'+esc(m.model)+'">'+logoFor(m.provider)+'<div class="tx"><div class="nm">'+esc(m.model)+'</div></div><svg class="ck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12l5 5 9-9"/></svg></div>').join('')).join('');
  modelList.querySelectorAll('.modal-opt').forEach(o=>o.addEventListener('click',()=>{
    setCurModel(MODELS.find(m=>m.provider===o.dataset.provider&&m.model===o.dataset.model)||curModel);
    renderProviders();closeModelModal();
  }));
  modelVeil.hidden=false;
}
function closeModelModal(){modelVeil.hidden=true}
document.getElementById('modelModalClose').addEventListener('click',closeModelModal);
modelVeil.addEventListener('click',e=>{if(e.target===modelVeil)closeModelModal()});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModelModal()});

document.getElementById('toggle').addEventListener('click',()=>document.getElementById('app').classList.toggle('collapsed'));
function renderConvs(){
  const c=document.getElementById('convs');
  if(!chats.length){c.innerHTML='<div class="dh">Aucune discussion</div>';return}
  c.innerHTML='<div class="dh">Récent</div>'+chats.map(ch=>'<div class="conv '+(String(ch.id)===String(activeId)?'on':'')+'" data-id="'+ch.id+'">'+(ch.provider?logoFor(ch.provider):'')+'<span class="tt">'+escAttr(ch.title)+'</span><button class="del" data-del="'+ch.id+'" title="Supprimer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M6 7h12M9 7V5h6v2M8 7l1 13h6l1-13"/></svg></button></div>').join('');
  c.querySelectorAll('.conv').forEach(el=>el.addEventListener('click',()=>openChat(el.dataset.id)));
  c.querySelectorAll('[data-del]').forEach(b=>b.addEventListener('click',e=>{e.stopPropagation();delChat(b.dataset.del)}));
}
async function delChat(id){
  if(String(activeId)===String(id))newChat();
  chats=chats.filter(c=>String(c.id)!==String(id));renderConvs();
  try{await fetch(api+'/v1/conversations/'+encodeURIComponent(id),{method:'DELETE',credentials:'include'})}catch(_){}
}

const thread=document.getElementById('thread'),empty=document.getElementById('empty'),scroll=document.getElementById('scroll'),ta=document.getElementById('ta'),send=document.getElementById('send');
// Chaque conversation vit à sa propre URL (/chat/<uuid>), et « nouvelle
// discussion » à /chat/new — sans ça, un refresh ou un lien partagé
// ramène toujours à la racine au lieu de rouvrir la bonne conversation.
const shareBtn=document.getElementById('shareBtn'),sharePop=document.getElementById('sharePop'),shareUrl=document.getElementById('shareUrl');
function updateShareBtn(){shareBtn.hidden=!activeId;shareBtn.classList.remove('on');sharePop.hidden=true}
function newChat(push){activeId=null;thread.innerHTML='';thread.style.display='none';empty.style.display='';ta.value='';autosize();send.disabled=true;renderConvs();updateShareBtn();if(push!==false&&location.pathname!=='/chat/new')history.pushState({chat:null},'','/chat/new')}
document.getElementById('newChat').addEventListener('click',()=>newChat());
async function openChat(id,push){
  activeId=id;empty.style.display='none';thread.style.display='';thread.innerHTML='';renderConvs();updateShareBtn();
  if(push!==false&&location.pathname!=='/chat/'+id)history.pushState({chat:id},'','/chat/'+encodeURIComponent(id));
  const ch=chats.find(c=>String(c.id)===String(id));
  if(ch){const m=PROVIDERS.find(p=>p.provider===ch.provider);if(m){curModel=MODELS.find(x=>x.provider===ch.provider&&x.model===ch.model)||m;renderProviders()}}
  try{
    const r=await fetch(api+'/v1/conversations/'+encodeURIComponent(id)+'/messages',{credentials:'include'});
    const msgs=r.ok?await r.json():[];
    msgs.forEach(m=>renderMsg(m.role,m.role==='user'?esc(m.content).replace(/\n/g,'<br>'):md(m.content),ch&&ch.provider,ch&&ch.model));
  }catch(_){}
  scroll.scrollTop=scroll.scrollHeight;
}
shareBtn.addEventListener('click',async()=>{
  if(!activeId)return;
  if(!sharePop.hidden){sharePop.hidden=true;return}
  try{
    const r=await fetch(api+'/v1/conversations/'+encodeURIComponent(activeId)+'/share',{method:'POST',credentials:'include'});
    if(!r.ok)return;
    shareUrl.value=location.origin+'/chat/'+activeId+'?public=1';
    shareBtn.classList.add('on');sharePop.hidden=false;shareUrl.select()
  }catch(_){}
});
document.getElementById('shareCopy').addEventListener('click',()=>{shareUrl.select();try{navigator.clipboard.writeText(shareUrl.value)}catch(_){document.execCommand('copy')}});
document.getElementById('shareOff').addEventListener('click',async()=>{
  if(!activeId)return;
  try{await fetch(api+'/v1/conversations/'+encodeURIComponent(activeId)+'/share',{method:'DELETE',credentials:'include'})}catch(_){}
  shareBtn.classList.remove('on');sharePop.hidden=true;
});
window.addEventListener('popstate',e=>{
  const id=e.state&&e.state.chat;
  if(id)openChat(id,false);else newChat(false);
});

function esc(s){return String(s||'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}
function escAttr(s){return esc(s).replace(/"/g,'&quot;')}
// Pas de vrai streaming (le client HTTP ne lit pas les réponses en flux) :
// on simule la frappe en révélant le texte final progressivement, avec un
// pas adapté à la longueur pour que ça reste rapide sur une longue réponse.
function machineAEcrire(el,who,fullText){
  const pas=Math.max(1,Math.ceil(fullText.length/120));
  let i=0;
  const tick=()=>{
    i=Math.min(fullText.length,i+pas);
    el.innerHTML='<div class="who">'+esc(who)+'</div>'+md(fullText.slice(0,i));
    scroll.scrollTop=scroll.scrollHeight;
    if(i<fullText.length)requestAnimationFrame(tick)
  };
  requestAnimationFrame(tick);
}
// Coloration syntaxique légère, générique (pas de vrai lexer par langage) :
// commentaires/chaînes d'abord (pour ne jamais re-matcher leur contenu),
// puis nombres et mots-clés usuels toutes langues confondues.
function hl(code){
  const KW=/\b(function|const|let|var|return|if|else|for|while|do|switch|case|break|continue|class|extends|new|async|await|try|catch|finally|throw|import|export|from|as|default|def|elif|lambda|None|True|False|echo|public|private|protected|static|void|int|float|bool|string|fn|struct|impl|use|match|pub|mod|self|Self|SELECT|FROM|WHERE|INSERT|INTO|VALUES|UPDATE|SET|DELETE|CREATE|TABLE|JOIN|ON|AND|OR|NOT|NULL|ORDER|BY|GROUP|LIMIT)\b/g;
  const NUM=/\b\d+(\.\d+)?\b/g;
  const seg=(t)=>t.replace(KW,x=>'<span class="tok-kw">'+x+'</span>').replace(NUM,x=>'<span class="tok-num">'+x+'</span>');
  const re=/(\/\/[^\n]*|\/\*[\s\S]*?\*\/|"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*')/g;
  let out='',last=0,m;
  while((m=re.exec(code))){
    out+=seg(code.slice(last,m.index));
    const tok=m[0];
    out+='<span class="tok-'+((tok[0]==='/')?'cm':'str')+'">'+tok+'</span>';
    last=re.lastIndex;
  }
  out+=seg(code.slice(last));
  return out;
}
function md(s){
  s=esc(s);
  // Les blocs code sont extraits AVANT le découpage en lignes ci-dessous :
  // sinon chaque ligne interne d'un bloc ```...``` se retrouve traitée comme
  // un paragraphe séparé (d'où le rendu « une ligne par <p>, tout collé »).
  const blocks=[];
  s=s.replace(/```(\w*)\n?([\s\S]*?)```/g,(m,lang,c)=>{
    c=c.replace(/\n$/,'');
    const chip=lang?'<div class="code-lang">'+esc(lang)+'</div>':'';
    blocks.push('<pre>'+chip+'<code>'+hl(c)+'</code></pre>');
    return ' B'+(blocks.length-1)+' ';
  });
  s=s.replace(/`([^`]+)`/g,'<code>$1</code>');
  s=s.replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>');
  const lines=s.split('\n');let out='',list=null;
  for(let ln of lines){
    const bm=/^B(\d+)$/.exec(ln.trim());
    if(bm){if(list){out+=list==='ul'?'</ul>':'</ol>';list=null}out+=blocks[+bm[1]];continue}
    if(/^\s*[-*]\s+/.test(ln)){if(list!=='ul'){out+='<ul>';list='ul'}out+='<li>'+ln.replace(/^\s*[-*]\s+/,'')+'</li>'}else if(/^\s*\d+\.\s+/.test(ln)){if(list!=='ol'){out+='<ol>';list='ol'}out+='<li>'+ln.replace(/^\s*\d+\.\s+/,'')+'</li>'}else{if(list){out+=list==='ul'?'</ul>':'</ol>';list=null}if(ln.trim())out+='<p>'+ln+'</p>'}
  }
  if(list)out+=list==='ul'?'</ul>':'</ol>';
  return out;
}
function renderMsg(role,html,provider,model){
  const d=document.createElement('div');d.className='msg '+(role==='user'?'u':'a');
  const ava=role==='user'?(document.getElementById('side-av').textContent):logoFor(provider);
  const label=MODELS.find(m=>m.provider===provider);
  const who=model||(label?label.model:'')||(label?label.label:'')||provider||'Noliae AI';
  d.innerHTML='<div class="ava">'+ava+'</div><div class="body">'+(role==='assistant'?'<div class="who">'+esc(who)+'</div>':'')+html+'</div>';
  thread.appendChild(d);scroll.scrollTop=scroll.scrollHeight;return d.querySelector('.body')
}

const attachBtn=document.getElementById('attach'),attachInput=document.getElementById('attachInput');
attachBtn.addEventListener('click',()=>attachInput.click());
attachInput.addEventListener('change',async()=>{
  const file=attachInput.files[0];attachInput.value='';
  if(!file)return;
  const foot=document.getElementById('foot');
  const avant=foot.textContent;
  foot.textContent='Envoi de « '+file.name+' »…';
  try{
    const content=await file.text();
    if(!content.trim())throw new Error('Fichier vide.');
    const r=await fetch(api+'/api/documents',{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify({title:file.name,content})});
    const data=await r.json().catch(()=>({}));
    if(!r.ok)throw new Error(data.detail||'Envoi impossible.');
    foot.textContent='« '+file.name+' » ajouté — le contexte sera utilisé dans vos prochains messages.';
  }catch(e){foot.textContent=(e instanceof TypeError)?'La connexion à nos serveurs semble bloquée par une extension (bloqueur de publicités/traceurs).':(e.message||'Envoi du document impossible.')}
  setTimeout(()=>{foot.textContent=avant},4000);
});
function autosize(){ta.style.height='auto';ta.style.height=Math.min(ta.scrollHeight,180)+'px'}
ta.addEventListener('input',()=>{autosize();send.disabled=!ta.value.trim()||busy});
ta.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();submit()}});
send.addEventListener('click',submit);
document.querySelectorAll('#sugg button').forEach(b=>b.addEventListener('click',()=>{ta.value=b.textContent;autosize();send.disabled=false;submit()}));

async function submit(){
  const q=ta.value.trim();if(!q||busy||!curModel)return;
  busy=true;send.disabled=true;
  const isNew=!activeId;
  if(isNew){empty.style.display='none';thread.style.display=''}
  renderMsg('user',esc(q).replace(/\n/g,'<br>'));
  ta.value='';autosize();
  const provider=curModel.provider;
  const body=renderMsg('assistant','<div class="dots"><i></i><i></i><i></i></div>',provider,curModel.model);
  try{
    const r=await fetch(api+'/v1/ia',{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify({message:q,provider:curModel.provider,model:curModel.model,conversation_id:activeId||undefined})});
    const data=await r.json().catch(()=>({}));
    if(!r.ok)throw data;
    activeId=data.conversation_id||activeId;
    if(isNew&&activeId)history.replaceState({chat:activeId},'','/chat/'+encodeURIComponent(activeId));
    machineAEcrire(body,curModel.model||curModel.label||curModel.provider,data.answer||'Aucune réponse reçue.');
    // Nouvelle conversation ou historique désynchronisé : on relit la liste
    // côté serveur plutôt que de deviner le titre/tri localement.
    await loadConvs();
  }catch(e){body.innerHTML='<p style="color:var(--pulse)">'+esc((e instanceof TypeError)?'La connexion à nos serveurs semble bloquée par une extension (bloqueur de publicités/traceurs). Désactive-la pour ce site, ou essaie en navigation privée, puis réessaie.':((e&&e.detail)||'Une erreur est survenue. Réessayez dans un instant.'))+'</p>'}
  scroll.scrollTop=scroll.scrollHeight;
  busy=false;send.disabled=!ta.value.trim();ta.focus()
}

const MODELS_KEY='noliae_ai_models_v1';
// Idem pour les modèles : on affiche tout de suite les pastilles connues
// (dernier catalogue vu) pendant que /v1/ia/models revalide en tâche de fond.
try{
  const cachedModels=JSON.parse(localStorage.getItem(MODELS_KEY)||'null');
  if(Array.isArray(cachedModels)&&cachedModels.length){
    MODELS=cachedModels;calculerProviders();
    let restaure0=null;
    try{const saved0=JSON.parse(localStorage.getItem(MODEL_KEY)||'null');if(saved0)restaure0=MODELS.find(m=>m.provider===saved0.provider&&m.model===saved0.model)}catch(_){}
    const parEconomie0=ORDRE_ECONOMIQUE.map(p=>PROVIDERS.find(m=>m.provider===p)).find(Boolean);
    setCurModel(restaure0||parEconomie0||PROVIDERS[0]);
    renderProviders();
    ta.disabled=false;document.getElementById('attach').disabled=false;
  }
}catch(_){}

fetch(api+'/v1/user/me',{credentials:'include'}).then(async r=>{if(!r.ok)throw 0;return r.json()}).then(user=>{
  document.getElementById('side-av').textContent=(user.name||user.email||'?').slice(0,2).toUpperCase();
  document.getElementById('side-name').textContent=user.name||user.email;
  document.getElementById('side-email').textContent=user.email;
  return fetch(api+'/v1/ia/models',{credentials:'include'});
}).then(async r=>{
  const data=await r.json().catch(()=>[]);
  MODELS=Array.isArray(data)?data:(Array.isArray(data.models)?data.models:[]);
  if(!MODELS.length)throw 0;
  try{localStorage.setItem(MODELS_KEY,JSON.stringify(MODELS))}catch(_){}
  calculerProviders();
  let restaure=null;
  try{const saved=JSON.parse(localStorage.getItem(MODEL_KEY)||'null');if(saved)restaure=MODELS.find(m=>m.provider===saved.provider&&m.model===saved.model)}catch(_){}
  const parEconomie=ORDRE_ECONOMIQUE.map(p=>PROVIDERS.find(m=>m.provider===p)).find(Boolean);
  setCurModel(restaure||parEconomie||PROVIDERS[0]);
  renderProviders();
  ta.disabled=false;document.getElementById('attach').disabled=false;
  loadConvs().then(()=>{
    // Ouvre directement la conversation de l'URL (/chat/<uuid>) au chargement —
    // sinon un refresh ou un lien partagé retombe toujours sur l'accueil.
    const m=/^\/chat\/([^/]+)$/.exec(location.pathname);
    if(m&&m[1]!=='new')openChat(m[1],false);
    history.replaceState({chat:(m&&m[1]!=='new')?m[1]:null},'',location.pathname);
  });
}).catch(()=>{ if(!MODELS.length){ goLogin(); } });
})();
</script>
</body></html>
